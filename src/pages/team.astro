---
import Layout from '../layouts/Layout.astro';
import team from '../data/team.json';

const base = import.meta.env.BASE_URL;

const initials = (name) =>
	name
		.split(" ")
		.filter(Boolean)
		.slice(0, 2)
		.map((w) => w[0])
		.join("")
		.toUpperCase();
---

<Layout title="Our Team">
	<h1 class="text-4xl font-extrabold text-slate-900">Our Team</h1>
	<p class="mt-2 max-w-2xl text-slate-600">
		The people behind PGNX &mdash; students and graduates who walked the Pakistan &rarr; Germany path
		and now help others do the same.
	</p>

	<div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
		{team.map((m) => (
			<div class="rounded-2xl border border-slate-200 bg-white p-6 text-center shadow-sm transition-all duration-200 hover:-translate-y-1 hover:shadow-md">
				{m.photo ? (
					<img src={`${base}team/${m.photo}`} alt={m.name} class="mx-auto h-24 w-24 rounded-full object-cover ring-4 ring-indigo-100" />
				) : (
					<div class="mx-auto flex h-24 w-24 items-center justify-center rounded-full bg-indigo-100 text-2xl font-extrabold text-indigo-700 ring-4 ring-indigo-50">
						{initials(m.name)}
					</div>
				)}
				<h2 class="mt-4 font-bold text-slate-900">{m.name}</h2>
				<p class="mt-1 text-sm text-indigo-600">{m.role}</p>
				{m.bio && <p class="mt-3 text-sm leading-relaxed text-slate-500">{m.bio}</p>}
			</div>
		))}
	</div>

	<div class="mt-12 rounded-2xl border border-slate-200 bg-white px-8 py-8 text-center shadow-sm">
		<h2 class="text-lg font-bold text-slate-900">Have a question for the team?</h2>
		<p class="mt-1 text-sm text-slate-600">We read every message.</p>
		<a href={`${base}contact`} class="mt-4 inline-block rounded-full bg-indigo-700 px-6 py-3 text-sm font-semibold text-white hover:bg-indigo-800">Contact us</a>
	</div>
</Layout>