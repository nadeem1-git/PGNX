---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Grade Converter">
	<span class="inline-block rounded-full bg-orange-500 px-4 py-1 text-xs font-semibold uppercase tracking-wide text-white">Now Live</span>
	<h1 class="mt-3 text-4xl font-extrabold text-slate-900">German Grade Converter</h1>
	<p class="mt-2 text-slate-600">Convert your CGPA or percentage into the German grading system in seconds &mdash; free and online.</p>

	<section class="mt-8 rounded-2xl border border-slate-200 bg-white p-8 shadow-sm">
		<p class="leading-relaxed text-slate-600">
			PGNX now has its own German Grade Converter, built for Pakistani and international students.
			Whether you're preparing university applications or just want to know where your grades stand
			in the German system, this tool gets you an instant conversion &mdash; no sign-up required.
		</p>

		<ul class="mt-6 space-y-2 text-slate-600">
			<li>✅ Free to use</li>
			<li>✅ Fast &amp; simple interface</li>
			<li>✅ Helpful for German university applications</li>
			<li>✅ Designed specially for students</li>
		</ul>

		<div class="mt-8 text-center">
			<a href="https://grade-converter-pgnx.vercel.app/" target="_blank" rel="noopener noreferrer"
				class="inline-flex items-center gap-2 rounded-md bg-indigo-700 px-6 py-3 text-sm font-semibold text-white hover:bg-indigo-800">
				Try the Grade Converter &rarr;
			</a>
		</div>
	</section>
</Layout>