---
import '../styles/global.css';
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>PGNX</title>
	</head>
	<body class="min-h-screen bg-gradient-to-b from-white via-green-50 to-white text-gray-900 relative">

	<div
		class="pointer-events-none fixed inset-0 -z-10"
		style="background-image: radial-gradient(circle, #16653440 1px, transparent 1px); background-size: 24px 24px;"
	></div>
	<div class="pointer-events-none fixed left-1/2 top-40 -z-10 h-[500px] w-[500px] -translate-x-1/2 rounded-full bg-green-300 opacity-20 blur-3xl"></div>

	<img
		src="/logo.jpg"
		alt=""
		class="pointer-events-none fixed left-1/2 top-1/2 -z-10 h-[600px] w-[600px] -translate-x-1/2 -translate-y-1/2 rounded-full object-cover opacity-5 grayscale"
	/>

		<!-- Top bar -->
		<header class="w-full py-4 px-6 flex items-center justify-between">
			<a href="/" class="flex flex-col items-center gap-1">
				<img src="/logo.jpg" alt="PGNX logo" class="h-20 w-20 rounded-full object-cover border border-green-100" />
				<span class="text-sm font-bold text-green-800">PGNX</span>
			</a>
		</header>

		<!-- Side menu toggle tab -->
		<button
			id="menu-toggle"
			class="fixed left-0 top-1/2 -translate-y-1/2 z-40 flex flex-col items-center gap-2 rounded-r-xl bg-green-800 text-white px-2 py-5 [writing-mode:vertical-rl]"
		>
			<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="[writing-mode:horizontal-tb] rotate-90">
				<path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
				<path d="M9 22V12h6v10"/>
			</svg>
			HOME
		</button>

		<!-- Slide-out side menu -->
		<nav
			id="side-menu"
			class="fixed left-0 top-0 h-full w-64 -translate-x-full bg-green-900 text-white p-6 transition-transform duration-300 z-50"
		>
			<button id="menu-close" class="mb-6 text-sm text-green-200">&#10005; Close</button>
			<ul class="space-y-4 font-medium">
				<li><a href="/" class="hover:text-green-300">Home</a></li>
				<li><a href="/admission" class="hover:text-green-300">Admission</a></li>
				<li><a href="/visa" class="hover:text-green-300">Visa</a></li>
				<li><a href="/resources" class="hover:text-green-300">Resources</a></li>
				<li><a href="/about" class="hover:text-green-300">About Us</a></li>
				<li><a href="/contact" class="hover:text-green-300">Contact</a></li>
			</ul>
		</nav>

		<!-- Main content -->
		<main class="px-6 py-12 max-w-4xl mx-auto">

			<!-- Hero card -->
			<section class="rounded-2xl bg-white border border-green-100 shadow-sm px-8 py-12 text-center">
				<div class="mx-auto mb-8 h-[2px] w-40" style="background: linear-gradient(to right, transparent, #16a34a, transparent);"></div>
				<h1 class="text-5xl font-extrabold text-green-800">PGNX</h1>
				<p class="mt-2 text-lg font-semibold text-gray-800">Pakistan Germany Nexus</p>
				<p class="text-lg text-green-700">A community for help</p>

				<div class="mt-10">
					<p class="text-sm font-semibold uppercase tracking-wide text-green-700">&mdash; Our founder's message &mdash;</p>
					<p class="mt-2 italic text-gray-700">"Love for all, hatred for none"</p>
				</div>
			</section>

		<!-- Mission -->
			<section class="mt-8 rounded-2xl bg-white border border-green-100 shadow-sm px-8 py-10 text-center">
				<h2 class="text-xl font-bold text-green-800">Our Mission</h2>
				<p class="mt-4 text-gray-700 leading-relaxed max-w-2xl mx-auto">
					PGNX exists to make the journey from Pakistan to Germany less confusing and less lonely.
					We bring together clear, practical guidance on admissions and visas with the support of a
					community that's walked the same path — so no one has to figure it out alone.
				</p>
			</section>
			
			<!-- Admission / Visa cards -->
			<section class="mt-8 grid gap-6 sm:grid-cols-2">
				<div class="rounded-xl bg-white border border-green-100 shadow-sm p-6">
					<div class="h-12 w-12 rounded-full bg-green-100 flex items-center justify-center text-green-700">
						<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
							<path d="M22 10L12 5 2 10l10 5 10-5z"/>
							<path d="M6 12v5c0 1.5 3 3 6 3s6-1.5 6-3v-5"/>
						</svg>
					</div>
					<h2 class="mt-4 text-lg font-bold">Admission</h2>
					<p class="mt-1 text-sm text-gray-600">Get guidance and support for your admission process.</p>
					<a href="/admission" class="mt-4 inline-block rounded-md bg-green-800 text-white text-sm font-semibold px-4 py-2 hover:bg-green-900">Learn More &rarr;</a>
				</div>

				<div class="rounded-xl bg-white border border-green-100 shadow-sm p-6">
					<div class="h-12 w-12 rounded-full bg-green-100 flex items-center justify-center text-green-700">
						<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
							<circle cx="12" cy="12" r="10"/>
							<path d="M2 12h20M12 2a15 15 0 0 1 0 20 15 15 0 0 1 0-20z"/>
						</svg>
					</div>
					<h2 class="mt-4 text-lg font-bold">Visa</h2>
					<p class="mt-1 text-sm text-gray-600">Information and assistance for your visa process.</p>
					<a href="/visa" class="mt-4 inline-block rounded-md bg-green-800 text-white text-sm font-semibold px-4 py-2 hover:bg-green-900">Learn More &rarr;</a>
				</div>
			</section>

			<!-- Start section -->
			<section class="mt-8 rounded-2xl bg-white border border-green-100 shadow-sm px-8 py-10 text-center">
				<div class="mx-auto h-12 w-12 rounded-full bg-green-100 flex items-center justify-center text-green-700">
					<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
						<path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
						<circle cx="9" cy="7" r="4"/>
						<path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/>
					</svg>
				</div>
				<h2 class="mt-4 text-xl font-bold">Gathered all info right?</h2>
				<p class="mt-2 text-gray-600">Want to start the process, click here.</p>
				<button class="mt-6 rounded-md bg-green-800 text-white font-semibold px-6 py-2.5 hover:bg-green-900">
					Start &rarr;
				</button>
			</section>
		</main>

		<!-- Footer -->
		<footer class="mt-12 border-t border-green-100 py-6 px-6 flex flex-col sm:flex-row items-center justify-between gap-3 text-sm text-gray-500 max-w-4xl mx-auto">
			<p>&copy; 2025 PGNX &mdash; Pakistan Germany Nexus. All rights reserved.</p>
			<div class="flex gap-4">
				<a href="#" aria-label="Facebook" class="hover:text-green-700">FB</a>
				<a href="#" aria-label="Instagram" class="hover:text-green-700">IG</a>
				<a href="#" aria-label="WhatsApp" class="hover:text-green-700">WA</a>
			</div>
		</footer>

		<script>
			const toggle = document.getElementById("menu-toggle");
			const menu = document.getElementById("side-menu");
			const close = document.getElementById("menu-close");

			toggle?.addEventListener("click", () => {
				menu?.classList.remove("-translate-x-full");
			});
			close?.addEventListener("click", () => {
				menu?.classList.add("-translate-x-full");
			});
		</script>
	</body>
</html>