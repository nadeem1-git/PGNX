---
import Layout from '../layouts/Layout.astro';
const base = import.meta.env.BASE_URL;
---

<Layout title="Home">
	<!-- Hero -->
	<section class="overflow-hidden rounded-3xl bg-gradient-to-br from-indigo-700 via-indigo-800 to-indigo-950 px-8 py-20 text-center text-white shadow-xl">
		<span class="inline-block rounded-full bg-white/15 px-4 py-1 text-xs font-semibold uppercase tracking-wide">Pakistan &rarr; Germany</span>
		<h1 class="mt-6 text-5xl font-extrabold tracking-tight sm:text-6xl">PGNX</h1>
		<p class="mt-3 text-xl font-medium text-indigo-100">Pakistan Germany Nexus</p>
		<p class="mt-1 text-indigo-200">A community for help, every step of the way.</p>
		<div class="mt-8 flex flex-wrap justify-center gap-4">
			<a href={`${base}start`} class="rounded-full bg-white px-6 py-3 text-sm font-semibold text-indigo-700 hover:bg-indigo-50">Start your journey &rarr;</a>
			<a href={`${base}admission`} class="rounded-full border border-white/30 px-6 py-3 text-sm font-semibold text-white hover:bg-white/10">Explore admissions</a>
		</div>
	</section>

	<!-- Mission -->
	<section class="mt-8 rounded-2xl border border-slate-200 bg-white px-8 py-10 text-center shadow-sm">
		<h2 class="text-xl font-bold text-slate-900">Our Mission</h2>
		<p class="mt-4 mx-auto max-w-2xl leading-relaxed text-slate-600">
			PGNX exists to make the journey from Pakistan to Germany less confusing and less lonely.
			We bring together clear, practical guidance on admissions and visas with the support of a
			community that's walked the same path — so no one has to figure it out alone.
		</p>
	</section>

	<!-- Ticker -->
	<section class="relative left-1/2 -ml-[50vw] mt-8 w-screen overflow-hidden bg-slate-900 py-4">
		<div class="ticker-track flex whitespace-nowrap">
			<div class="ticker-content flex items-center gap-12 pr-12 text-sm font-medium text-white">
				<span>📌 Always verify tuition and deadline details on the official university website before applying.</span>
				<span>📌 Bachelor's applicants need 13 years of education — complete 2 semesters in Pakistan first if you're one year short.</span>
				<span>📌 Master's applicants need 16 years of education total, including 2+2 year Bachelor's structures.</span>
				<span>📌 Start your blocked account and health insurance early — both are required before your visa appointment.</span>
				<span>📌 Visa appointment waiting times can be long — apply as early as possible.</span>
				<span>📌 As of 1 Sept 2024, proof of funds is set at 992 EUR/month (11,904 EUR/year).</span>
				<span>📌 Karachi consulate covers Sindh &amp; Balochistan; Islamabad covers Punjab, KP, Gilgit-Baltistan &amp; AJK.</span>
				<span>📌 Double-check every document before submission — incomplete files are the #1 cause of visa delays.</span>
			</div>
			<div class="ticker-content flex items-center gap-12 pr-12 text-sm font-medium text-white" aria-hidden="true">
				<span>📌 Always verify tuition and deadline details on the official university website before applying.</span>
				<span>📌 Bachelor's applicants need 13 years of education — complete 2 semesters in Pakistan first if you're one year short.</span>
				<span>📌 Master's applicants need 16 years of education total, including 2+2 year Bachelor's structures.</span>
				<span>📌 Start your blocked account and health insurance early — both are required before your visa appointment.</span>
				<span>📌 Visa appointment waiting times can be long — apply as early as possible.</span>
				<span>📌 As of 1 Sept 2024, proof of funds is set at 992 EUR/month (11,904 EUR/year).</span>
				<span>📌 Karachi consulate covers Sindh &amp; Balochistan; Islamabad covers Punjab, KP, Gilgit-Baltistan &amp; AJK.</span>
				<span>📌 Double-check every document before submission — incomplete files are the #1 cause of visa delays.</span>
			</div>
		</div>
	</section>

	<!-- Service cards -->
	<section class="mt-8">
		<h2 class="text-center text-2xl font-bold text-slate-900">What We Help With</h2>
		<div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
			<a href={`${base}admission`} class="group rounded-2xl border border-slate-200 bg-white p-6 text-center shadow-sm">
				<div class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-indigo-50 text-indigo-600">
					<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
						<path d="M22 10L12 5 2 10l10 5 10-5z"/>
						<path d="M6 12v5c0 1.5 3 3 6 3s6-1.5 6-3v-5"/>
					</svg>
				</div>
				<h3 class="mt-4 font-bold text-slate-900">Admission</h3>
				<p class="mt-1 text-sm text-slate-500">Guidance and support for your admission process.</p>
				<span class="mt-4 inline-block text-sm font-semibold text-indigo-600 group-hover:underline">Learn more &rarr;</span>
			</a>

			<a href={`${base}visa`} class="group rounded-2xl border border-slate-200 bg-white p-6 text-center shadow-sm">
				<div class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-indigo-50 text-indigo-600">
					<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
						<circle cx="12" cy="12" r="10"/>
						<path d="M2 12h20M12 2a15 15 0 0 1 0 20 15 15 0 0 1 0-20z"/>
					</svg>
				</div>
				<h3 class="mt-4 font-bold text-slate-900">Visa</h3>
				<p class="mt-1 text-sm text-slate-500">Information and assistance for your visa process.</p>
				<span class="mt-4 inline-block text-sm font-semibold text-indigo-600 group-hover:underline">Learn more &rarr;</span>
			</a>

			<a href={`${base}universities`} class="group rounded-2xl border border-slate-200 bg-white p-6 text-center shadow-sm">
				<div class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-indigo-50 text-indigo-600">
					<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
						<path d="M3 21h18M4 21V9l8-6 8 6v12M9 21v-6h6v6"/>
					</svg>
				</div>
				<h3 class="mt-4 font-bold text-slate-900">Universities</h3>
				<p class="mt-1 text-sm text-slate-500">Browse universities and programs, organized by field.</p>
				<span class="mt-4 inline-block text-sm font-semibold text-indigo-600 group-hover:underline">Learn more &rarr;</span>
			</a>

			<a href={`${base}german-language`} class="group rounded-2xl border border-slate-200 bg-white p-6 text-center shadow-sm">
				<div class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-indigo-50 text-indigo-600">
					<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
						<path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/>
						<path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/>
					</svg>
				</div>
				<h3 class="mt-4 font-bold text-slate-900">German Language</h3>
				<p class="mt-1 text-sm text-slate-500">Resources and guidance for learning German.</p>
				<span class="mt-4 inline-block text-sm font-semibold text-indigo-600 group-hover:underline">Learn more &rarr;</span>
			</a>

			<a href={`${base}document-preparation`} class="group rounded-2xl border border-slate-200 bg-white p-6 text-center shadow-sm">
				<div class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-indigo-50 text-indigo-600">
					<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
						<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
						<polyline points="14 2 14 8 20 8"/>
						<line x1="8" y1="13" x2="16" y2="13"/>
						<line x1="8" y1="17" x2="16" y2="17"/>
					</svg>
				</div>
				<h3 class="mt-4 font-bold text-slate-900">Document Preparation</h3>
				<p class="mt-1 text-sm text-slate-500">Checklists and guidance for your required documents.</p>
				<span class="mt-4 inline-block text-sm font-semibold text-indigo-600 group-hover:underline">Learn more &rarr;</span>
			</a>

			<a href={`${base}resources`} class="group rounded-2xl border border-slate-200 bg-white p-6 text-center shadow-sm">
				<div class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-indigo-50 text-indigo-600">
					<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
						<path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/>
						<path d="M12 6.5v10M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/>
					</svg>
				</div>
				<h3 class="mt-4 font-bold text-slate-900">Resources</h3>
				<p class="mt-1 text-sm text-slate-500">Photo requirements, embassy checklists, and cost breakdowns.</p>
				<span class="mt-4 inline-block text-sm font-semibold text-indigo-600 group-hover:underline">Learn more &rarr;</span>
			</a>

			<a href={`${base}cities`} class="group rounded-2xl border border-slate-200 bg-white p-6 text-center shadow-sm">
				<div class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-indigo-50 text-indigo-600">
					<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
						<path d="M12 21s-6-5.5-6-10a6 6 0 0 1 12 0c0 4.5-6 10-6 10z"/>
						<circle cx="12" cy="11" r="2"/>
					</svg>
				</div>
				<h3 class="mt-4 font-bold text-slate-900">Cities</h3>
				<p class="mt-1 text-sm text-slate-500">Explore German cities and what to know before you move there.</p>
				<span class="mt-4 inline-block text-sm font-semibold text-indigo-600 group-hover:underline">Learn more &rarr;</span>
			</a>

			<a href={`${base}city-registration`} class="group rounded-2xl border border-slate-200 bg-white p-6 text-center shadow-sm">
				<div class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-indigo-50 text-indigo-600">
					<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
						<path d="M3 21h18"/>
						<path d="M5 21V7l7-4 7 4v14"/>
						<path d="M9 9h1M9 13h1M14 9h1M14 13h1M9 21v-4h6v4"/>
					</svg>
				</div>
				<h3 class="mt-4 font-bold text-slate-900">City Registration</h3>
				<p class="mt-1 text-sm text-slate-500">Anmeldung guides for registering your address, city by city.</p>
				<span class="mt-4 inline-block text-sm font-semibold text-indigo-600 group-hover:underline">Learn more &rarr;</span>
			</a>
		</div>
	</section>

	<!-- Grade Converter highlight -->
	<section class="mt-8 rounded-2xl border border-orange-100 bg-gradient-to-r from-orange-50 to-amber-50 px-8 py-10 text-center">
		<span class="inline-block rounded-full bg-orange-500 px-4 py-1 text-xs font-semibold uppercase tracking-wide text-white">Now Live</span>
		<h2 class="mt-4 text-xl font-bold text-slate-900">German Grade Converter</h2>
		<p class="mt-2 mx-auto max-w-xl text-slate-600">Convert your CGPA or percentage into the German grading system in seconds — free and online.</p>
		<a href={`${base}grade-converter`} class="mt-6 inline-block rounded-full bg-orange-500 px-6 py-3 font-semibold text-white hover:bg-orange-600">
			Try It Now &rarr;
		</a>
	</section>

	<!-- Student Stories -->
	<section class="mt-8 rounded-2xl border border-slate-200 bg-white px-8 py-12 text-center shadow-sm">
		<p class="text-sm font-semibold uppercase tracking-widest text-indigo-600">Success Stories</p>
		<h2 class="mt-2 text-2xl font-bold text-slate-900 sm:text-3xl">Students Now in Germany</h2>

		<div class="mt-10 grid gap-6 text-left sm:grid-cols-3">
			<div class="rounded-xl border border-slate-200 p-6">
				<div class="text-amber-400">★★★★★</div>
				<p class="mt-3 text-sm italic leading-relaxed text-slate-600">"Placeholder testimonial text goes here."</p>
				<div class="mt-4 flex items-center gap-3">
					<div class="h-9 w-9 rounded-full bg-indigo-100"></div>
					<div>
						<p class="text-sm font-semibold text-slate-900">Aashir Muzaffar</p>
						<p class="text-xs text-slate-500">M.Sc Autonomous Systems &middot; Hochschule Bonn</p>
					</div>
				</div>
			</div>
			<div class="rounded-xl border border-slate-200 p-6">
				<div class="text-amber-400">★★★★★</div>
				<p class="mt-3 text-sm italic leading-relaxed text-slate-600">"Placeholder testimonial text goes here."</p>
				<div class="mt-4 flex items-center gap-3">
					<div class="h-9 w-9 rounded-full bg-indigo-100"></div>
					<div>
						<p class="text-sm font-semibold text-slate-900">Student Name</p>
						<p class="text-xs text-slate-500">MSc Information and Communication Systems &middot; TU Chemnitz</p>
					</div>
				</div>
			</div>
			<div class="rounded-xl border border-slate-200 p-6">
				<div class="text-amber-400">★★★★★</div>
				<p class="mt-3 text-sm italic leading-relaxed text-slate-600">"Placeholder testimonial text goes here."</p>
				<div class="mt-4 flex items-center gap-3">
					<div class="h-9 w-9 rounded-full bg-indigo-100"></div>
					<div>
						<p class="text-sm font-semibold text-slate-900">Student Name</p>
						<p class="text-xs text-slate-500">Program &middot; University</p>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- Closing CTA -->
	<section class="relative left-1/2 -ml-[50vw] mt-8 w-screen bg-slate-900 px-8 py-24 text-center text-white">
		<h2 class="text-3xl font-extrabold sm:text-5xl">Your Complete Guide to Germany</h2>
		<p class="mx-auto mt-4 max-w-xl text-lg text-slate-300">
			From admission to visa to your first German lesson — everything you need, in one place.
		</p>
		<a href={`${base}start`} class="mt-8 inline-block rounded-full bg-indigo-500 px-8 py-3 font-semibold text-white hover:bg-indigo-400">
			Get Started &rarr;
		</a>
	</section>

	<!-- Contact Us -->
	<section class="mt-8 rounded-2xl border border-slate-200 bg-white p-8 shadow-sm">
		<div class="text-center">
			<h2 class="text-2xl font-bold text-slate-900">Contact Us</h2>
			<p class="mt-2 text-slate-600">Have a question? Send us a message and we'll get back to you.</p>
		</div>

		<form
			action="https://formsubmit.co/pgnexus245@gmail.com"
			method="POST"
			class="mx-auto mt-8 max-w-xl space-y-4"
		>
			<input type="hidden" name="_subject" value="New message from PGNX website" />
			<input type="hidden" name="_template" value="table" />
			<input type="text" name="_honey" style="display:none" />

			<div class="grid gap-4 sm:grid-cols-2">
				<div>
					<label for="name" class="block text-sm font-semibold text-slate-700">Name</label>
					<input
						id="name"
						type="text"
						name="name"
						required
						class="mt-1.5 w-full rounded-md border border-slate-200 bg-white px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-400"
					/>
				</div>
				<div>
					<label for="phone" class="block text-sm font-semibold text-slate-700">Phone Number</label>
					<input
						id="phone"
						type="tel"
						name="phone"
						class="mt-1.5 w-full rounded-md border border-slate-200 bg-white px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-400"
					/>
				</div>
			</div>

			<div>
				<label for="email" class="block text-sm font-semibold text-slate-700">Email</label>
				<input
					id="email"
					type="email"
					name="email"
					required
					class="mt-1.5 w-full rounded-md border border-slate-200 bg-white px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-400"
				/>
			</div>

			<div>
				<label for="message" class="block text-sm font-semibold text-slate-700">Message</label>
				<textarea
					id="message"
					name="message"
					rows="5"
					required
					class="mt-1.5 w-full rounded-md border border-slate-200 bg-white px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-400"
				></textarea>
			</div>

			<button
				type="submit"
				class="w-full rounded-md bg-indigo-700 px-6 py-3 font-semibold text-white hover:bg-indigo-800"
			>
				Send Message
			</button>
		</form>
	</section>
</Layout>