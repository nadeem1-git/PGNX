---
import Layout from '../layouts/Layout.astro';
import programs from '../data/masterPrograms.json';

const base = import.meta.env.BASE_URL;

const universities = [...new Set((programs as { university: string }[]).map((p) => p.university))].sort((a, b) =>
	a.localeCompare(b)
);
---

<Layout title="Visa Tracker">
	<h1 class="text-4xl font-extrabold text-slate-900">Visa Tracker</h1>
	<p class="mt-2 max-w-2xl text-slate-600">
		See who is on the German student visa waiting list, by consulate and by month, and add yourself so the
		next person knows what to expect.
	</p>
	<a href="#share" class="mt-5 inline-flex items-center gap-2 rounded-full bg-indigo-700 px-6 py-3 text-sm font-semibold text-white hover:bg-indigo-800">
		Add yourself to the tracker &darr;
	</a>

	<div id="load-error" class="mt-8 hidden rounded-lg border border-amber-200 bg-amber-50 p-4 text-sm text-amber-900">
		The tracker is temporarily unavailable. Please try again in a little while.
	</div>

	<!-- Filters -->
	<div class="mt-8 flex flex-col gap-4 rounded-2xl border border-slate-200 bg-white p-4 shadow-sm sm:flex-row sm:flex-wrap sm:items-end">
		<div>
			<p class="text-xs font-semibold uppercase tracking-wide text-slate-500">Consulate</p>
			<div class="mt-2 flex flex-wrap gap-2">
				<button type="button" data-cons="all" class="cons-btn rounded-full border border-indigo-600 bg-indigo-600 px-4 py-1.5 text-sm font-medium text-white">All</button>
				<button type="button" data-cons="Islamabad" class="cons-btn rounded-full border border-slate-200 bg-white px-4 py-1.5 text-sm font-medium text-indigo-700 hover:border-indigo-400">Islamabad</button>
				<button type="button" data-cons="Karachi" class="cons-btn rounded-full border border-slate-200 bg-white px-4 py-1.5 text-sm font-medium text-indigo-700 hover:border-indigo-400">Karachi</button>
			</div>
		</div>
		<div>
			<label for="month-select" class="text-xs font-semibold uppercase tracking-wide text-slate-500">Joining month</label>
			<select id="month-select" class="mt-2 block w-full rounded-full border border-slate-200 bg-white px-4 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-400 sm:w-48">
				<option value="all">All months</option>
			</select>
		</div>
		<button id="clear-filters" type="button" class="hidden self-end rounded-full px-3 py-2 text-sm font-medium text-slate-500 hover:text-indigo-700 sm:ml-auto">Clear filters</button>
	</div>

	<!-- Key numbers -->
	<div class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
		<!-- 1. Total -->
		<div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
			<p class="text-xs font-semibold uppercase tracking-wide text-slate-500">Total members</p>
			<p id="stat-total" class="mt-2 text-5xl font-extrabold text-indigo-700">&hellip;</p>
			<p id="stat-total-sub" class="mt-2 text-xs text-slate-500">&nbsp;</p>
		</div>

		<!-- 2. By consulate -->
		<div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
			<p class="text-xs font-semibold uppercase tracking-wide text-slate-500">By consulate</p>
			<div id="consulate-chart" class="mt-4 space-y-4"></div>
		</div>

		<!-- 3. By month -->
		<div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:col-span-2">
			<div class="flex items-baseline justify-between gap-2">
				<p class="text-xs font-semibold uppercase tracking-wide text-slate-500">Members by joining month</p>
				<p class="text-xs text-slate-400">Tap a bar to filter</p>
			</div>
			<div id="month-chart" class="mt-4 overflow-x-auto"></div>
		</div>
	</div>

	<!-- Applicants table -->
	<section class="mt-6 rounded-2xl border border-slate-200 bg-white shadow-sm">
		<div class="flex flex-col gap-3 p-6 sm:flex-row sm:items-center sm:justify-between">
			<div>
				<h2 class="text-xl font-bold text-slate-900">Applicants</h2>
				<p class="mt-1 text-sm text-slate-500">Grouped by the day they joined the waiting list. Names are never shown.</p>
			</div>
			<input
				id="search-input"
				type="search"
				placeholder="Search by university&hellip;"
				class="w-full rounded-full border border-slate-200 bg-white px-5 py-2.5 text-sm shadow-sm focus:outline-none focus:ring-2 focus:ring-indigo-400 sm:w-64"
			/>
		</div>
		<div class="overflow-x-auto border-t border-slate-100">
			<table class="min-w-full text-left text-sm">
				<thead class="bg-slate-50 text-xs uppercase tracking-wide text-slate-500">
					<tr>
						<th class="px-4 py-3 font-semibold">#</th>
						<th class="px-4 py-3 font-semibold">University</th>
						<th class="px-4 py-3 font-semibold">Consulate</th>
						<th class="whitespace-nowrap px-4 py-3 font-semibold">Joining Date</th>
						<th class="whitespace-nowrap px-4 py-3 font-semibold">Got Submission</th>
						<th class="whitespace-nowrap px-4 py-3 font-semibold">Submitted On</th>
						<th class="whitespace-nowrap px-4 py-3 font-semibold">Correction Date</th>
						<th class="whitespace-nowrap px-4 py-3 font-semibold">Appointment Date</th>
						<th class="whitespace-nowrap px-4 py-3 font-semibold">Decision Date</th>
						<th class="whitespace-nowrap px-4 py-3 font-semibold">Visa Status</th>
					</tr>
				</thead>
				<tbody id="table-body"></tbody>
			</table>
		</div>
		<div class="flex flex-wrap items-center justify-between gap-3 border-t border-slate-100 p-4">
			<p id="table-count" class="text-xs text-slate-500">&nbsp;</p>
			<button id="more-btn" class="hidden rounded-full border border-slate-300 px-4 py-2 text-sm font-medium text-indigo-600 hover:bg-indigo-50">Show more</button>
		</div>
	</section>

	<!-- Add yourself -->
	<section id="share" class="mx-auto mt-6 max-w-2xl scroll-mt-24 rounded-2xl border border-slate-200 bg-white p-6 shadow-sm sm:p-8">
		<h2 class="text-2xl font-bold text-slate-900">Add yourself to the tracker</h2>
		<p class="mt-1 text-sm text-slate-600">
			Your name is only seen by the PGNX team. It is never shown on this website.
		</p>

		<form id="tracker-form" class="mt-6 space-y-6" novalidate>
			<input type="text" name="website" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />

			<div>
				<label for="applicant_name" class="text-sm font-semibold text-slate-700">Your name</label>
				<input id="applicant_name" name="name" type="text" maxlength="80" autocomplete="name" class="mt-2 w-full rounded-md border border-slate-200 bg-white px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-400" />
			</div>

			<div>
				<label for="university" class="text-sm font-semibold text-slate-700">University</label>
				<input id="university" name="university" type="text" list="university-list" maxlength="120" autocomplete="off" placeholder="Start typing, e.g. TU Dresden" class="mt-2 w-full rounded-md border border-slate-200 bg-white px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-400" />
				<datalist id="university-list">
					{universities.map((u) => <option value={u} />)}
				</datalist>
			</div>

			<fieldset>
				<legend class="text-sm font-semibold text-slate-700">Which consulate?</legend>
				<div class="mt-2 grid grid-cols-2 gap-3">
					<label class="cursor-pointer">
						<input type="radio" name="consulate" value="Islamabad" class="peer sr-only" />
						<span class="block rounded-xl border border-slate-200 px-4 py-3 text-center text-sm font-semibold text-slate-700 peer-checked:border-indigo-600 peer-checked:bg-indigo-50 peer-checked:text-indigo-700 peer-focus-visible:ring-2 peer-focus-visible:ring-indigo-400">Islamabad</span>
					</label>
					<label class="cursor-pointer">
						<input type="radio" name="consulate" value="Karachi" class="peer sr-only" />
						<span class="block rounded-xl border border-slate-200 px-4 py-3 text-center text-sm font-semibold text-slate-700 peer-checked:border-indigo-600 peer-checked:bg-indigo-50 peer-checked:text-indigo-700 peer-focus-visible:ring-2 peer-focus-visible:ring-indigo-400">Karachi</span>
					</label>
				</div>
			</fieldset>

			<div>
				<label for="joining_date" class="text-sm font-semibold text-slate-700">Joining date</label>
				<p class="mt-0.5 text-xs text-slate-500">The day you joined the visa portal waiting list.</p>
				<input id="joining_date" name="joining_date" type="date" class="mt-2 w-full rounded-md border border-slate-200 bg-white px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-400" />
			</div>

			<p class="text-xs leading-relaxed text-slate-500">
				Your university, consulate and joining date are shown publicly, without your name. Later updates
				(submission, appointment, decision) are added by the PGNX team &mdash; send them to us through the
				<a href={`${base}contact`} class="text-indigo-600 underline">contact form</a>.
			</p>

			<p id="form-msg" role="status" class="hidden"></p>

			<button id="submit-btn" type="submit" class="w-full rounded-md bg-indigo-700 px-6 py-3 font-semibold text-white hover:bg-indigo-800 disabled:opacity-60">
				Add me to the tracker
			</button>
		</form>
	</section>

	<p class="mt-6 text-xs leading-relaxed text-slate-500">
		Community-reported and unofficial. Real timelines vary from case to case, so treat these numbers as a
		rough guide, not a promise. Obviously false entries may be hidden.
	</p>
</Layout>

<script>
	const SUPABASE_URL = "https://nrwpfxgwlqlvelpgslgd.supabase.co";
	const SUPABASE_KEY = "sb_publishable_ihgevXeasyygrtA8u5LuJA_6lHV881v";
	const TABLE_URL = SUPABASE_URL + "/rest/v1/visa_applicants";
	const SELECT_COLS =
		"id,university,consulate,joining_date,got_submission_date,submitted_on,correction_date,appointment_date,decision_date,visa_status,created_at";
	const PAGE_SIZE = 100;
	const COOLDOWN_MS = 20000;
	const LAST_KEY = "pgnx_visa_last_submit";
	const MAX_MONTH_BARS = 12;
	const MONTHS = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
	const MONTHS_LONG = ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"];
	const WEEKDAYS = ["Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"];
	const CONSULATES = ["Islamabad", "Karachi"];
	const CONS_COLOR: Record<string, string> = { Islamabad: "bg-indigo-600", Karachi: "bg-sky-500" };

	type Row = {
		id: number;
		university: string;
		consulate: string;
		joining_date: string;
		got_submission_date: string | null;
		submitted_on: string | null;
		correction_date: string | null;
		appointment_date: string | null;
		decision_date: string | null;
		visa_status: string;
		created_at: string;
	};

	let allRows: Row[] = [];
	let consFilter = "all";
	let monthFilter = "all"; // "all" or "YYYY-MM"
	let searchText = "";
	let visibleLimit = PAGE_SIZE;

	const byId = (id: string) => document.getElementById(id) as HTMLElement;

	function el(tag: string, cls: string, text?: string): HTMLElement {
		const node = document.createElement(tag);
		node.className = cls;
		if (text !== undefined) node.textContent = text;
		return node;
	}

	function toUTC(s: string): number {
		return Date.parse(s + "T00:00:00Z");
	}
	function fmtShort(s: string | null): string {
		if (!s) return "";
		const [y, m, d] = s.split("-");
		return d + "-" + MONTHS[Number(m) - 1] + "-" + y;
	}
	function fmtLong(s: string): string {
		const dt = new Date(toUTC(s));
		return WEEKDAYS[dt.getUTCDay()] + ", " + dt.getUTCDate() + " " + MONTHS_LONG[dt.getUTCMonth()] + " " + dt.getUTCFullYear();
	}
	function plural(n: number, word: string): string {
		return n + " " + word + (n === 1 ? "" : "s");
	}
	// "2026-11" -> "Nov 2026" (or "Nov" when short)
	function monthLabel(key: string, short = false): string {
		const [y, m] = key.split("-");
		return MONTHS[Number(m) - 1] + (short ? "" : " " + y);
	}
	function monthKey(r: Row): string {
		return r.joining_date.slice(0, 7);
	}
	// every month from first to last, so the chart has no gaps
	function monthRange(first: string, last: string): string[] {
		const out: string[] = [];
		let [y, m] = first.split("-").map(Number);
		const [ly, lm] = last.split("-").map(Number);
		while (y < ly || (y === ly && m <= lm)) {
			out.push(y + "-" + String(m).padStart(2, "0"));
			m++;
			if (m > 12) {
				m = 1;
				y++;
			}
		}
		return out;
	}

	// ----- filtering -----
	function rowsFor(cons: string, month: string): Row[] {
		return allRows.filter(
			(r) => (cons === "all" || r.consulate === cons) && (month === "all" || monthKey(r) === month)
		);
	}
	function tableRows(): Row[] {
		const q = searchText.trim().toLowerCase();
		const rows = rowsFor(consFilter, monthFilter);
		return q ? rows.filter((r) => r.university.toLowerCase().includes(q)) : rows;
	}

	// ----- visual 1: total -----
	function renderTotal() {
		const rows = rowsFor(consFilter, monthFilter);
		byId("stat-total").textContent = String(rows.length);
		const parts: string[] = [];
		parts.push(consFilter === "all" ? "both consulates" : consFilter);
		parts.push(monthFilter === "all" ? "all months" : monthLabel(monthFilter));
		byId("stat-total-sub").textContent = parts.join(" \u00b7 ");
	}

	// ----- visual 2: by consulate (respects the month filter) -----
	function renderConsulateChart() {
		const box = byId("consulate-chart");
		box.textContent = "";
		const counts = CONSULATES.map((name) => ({ name, n: rowsFor(name, monthFilter).length }));
		const max = Math.max(1, ...counts.map((c) => c.n));
		for (const c of counts) {
			const dim = consFilter !== "all" && consFilter !== c.name;
			const row = el("button", "block w-full text-left transition-opacity " + (dim ? "opacity-40" : ""));
			row.setAttribute("type", "button");
			row.setAttribute("aria-label", "Show " + c.name + " only");
			const top = el("div", "flex items-baseline justify-between text-sm");
			top.append(el("span", "font-medium text-slate-700", c.name));
			top.append(el("span", "text-lg font-extrabold text-slate-900", String(c.n)));
			const track = el("div", "mt-1.5 h-3 overflow-hidden rounded-full bg-slate-100");
			const fill = el("div", "h-full rounded-full " + CONS_COLOR[c.name]);
			fill.style.width = c.n ? Math.max(6, Math.round((c.n / max) * 100)) + "%" : "0%";
			track.append(fill);
			row.append(top, track);
			row.addEventListener("click", () => setConsFilter(consFilter === c.name ? "all" : c.name));
			box.append(row);
		}
	}

	// ----- visual 3: by month (respects the consulate filter) -----
	function renderMonthChart() {
		const box = byId("month-chart");
		box.textContent = "";
		const rows = rowsFor(consFilter, "all");
		if (!rows.length) {
			box.append(el("p", "py-8 text-center text-sm text-slate-400", "No data yet."));
			return;
		}
		const keys = rows.map(monthKey).sort();
		let months = monthRange(keys[0], keys[keys.length - 1]);
		if (months.length > MAX_MONTH_BARS) months = months.slice(-MAX_MONTH_BARS);
		const counts: Record<string, number> = {};
		for (const r of rows) counts[monthKey(r)] = (counts[monthKey(r)] || 0) + 1;
		const max = Math.max(1, ...months.map((m) => counts[m] || 0));

		const wrap = el("div", "flex h-40 min-w-max items-end gap-2");
		let lastYear = "";
		for (const m of months) {
			const n = counts[m] || 0;
			const selected = monthFilter === m;
			const col = el("button", "group flex h-full w-12 flex-col items-center justify-end gap-1");
			col.setAttribute("type", "button");
			col.setAttribute("aria-label", monthLabel(m) + ": " + plural(n, "member"));
			col.append(el("span", "text-xs font-bold " + (selected ? "text-indigo-700" : "text-slate-600"), String(n)));
			const barArea = el("div", "flex w-full flex-1 items-end");
			const bar = el(
				"div",
				"w-full rounded-t-md transition-colors " +
					(selected ? "bg-indigo-700" : n ? "bg-indigo-300 group-hover:bg-indigo-400" : "bg-slate-200")
			);
			bar.style.height = n ? Math.max(8, Math.round((n / max) * 100)) + "%" : "4px";
			barArea.append(bar);
			col.append(barArea);
			const year = m.slice(0, 4);
			const label = monthLabel(m, true) + (year !== lastYear ? " \u2019" + year.slice(2) : "");
			lastYear = year;
			col.append(el("span", "text-[11px] " + (selected ? "font-bold text-indigo-700" : "text-slate-500"), label));
			col.addEventListener("click", () => setMonthFilter(monthFilter === m ? "all" : m));
			wrap.append(col);
		}
		box.append(wrap);
	}

	function renderTable() {
		const body = byId("table-body");
		body.textContent = "";
		const rows = tableRows();
		const shown = rows.slice(0, visibleLimit);

		if (!rows.length) {
			const tr = el("tr", "");
			const td = el("td", "px-4 py-6 text-center text-sm text-slate-500", allRows.length ? "No applicants match your search." : "No applicants yet. Be the first to add yourself!");
			(td as HTMLTableCellElement).colSpan = 10;
			tr.append(td);
			body.append(tr);
			byId("table-count").textContent = "";
			byId("more-btn").classList.add("hidden");
			return;
		}

		const perDate: Record<string, number> = {};
		for (const r of rows) perDate[r.joining_date] = (perDate[r.joining_date] || 0) + 1;

		const badge: Record<string, string> = {
			Approved: "border-green-200 bg-green-50 text-green-700",
			Rejected: "border-red-200 bg-red-50 text-red-700",
			Pending: "border-slate-200 bg-slate-50 text-slate-600",
		};

		let lastDate = "";
		for (const r of shown) {
			if (r.joining_date !== lastDate) {
				lastDate = r.joining_date;
				const head = el("tr", "bg-slate-100");
				const th = el(
					"td",
					"px-4 py-2 text-xs font-semibold uppercase tracking-wide text-slate-500",
					fmtLong(r.joining_date) + " \u00b7 " + plural(perDate[r.joining_date], "applicant")
				);
				(th as HTMLTableCellElement).colSpan = 10;
				head.append(th);
				body.append(head);
			}
			const tr = el("tr", "border-b border-slate-100 hover:bg-slate-50");
			const cells: string[] = [
				String(r.id),
				r.university,
				r.consulate,
				fmtShort(r.joining_date),
				fmtShort(r.got_submission_date),
				fmtShort(r.submitted_on),
				fmtShort(r.correction_date),
				fmtShort(r.appointment_date),
				fmtShort(r.decision_date),
			];
			cells.forEach((text, i) => {
				tr.append(el("td", "px-4 py-2.5 text-slate-700" + (i >= 3 ? " whitespace-nowrap" : ""), text));
			});
			const statusCell = el("td", "px-4 py-2.5");
			statusCell.append(el("span", "rounded-full border px-2.5 py-0.5 text-xs font-semibold " + (badge[r.visa_status] || badge.Pending), r.visa_status));
			tr.append(statusCell);
			body.append(tr);
		}

		byId("table-count").textContent = "Showing " + shown.length + " of " + plural(rows.length, "applicant");
		byId("more-btn").classList.toggle("hidden", rows.length <= shown.length);
	}


	function syncFilterUI() {
		consButtons.forEach((b) => {
			const active = (b.dataset.cons || "all") === consFilter;
			b.classList.toggle("bg-indigo-600", active);
			b.classList.toggle("text-white", active);
			b.classList.toggle("border-indigo-600", active);
			b.classList.toggle("bg-white", !active);
			b.classList.toggle("text-indigo-700", !active);
			b.classList.toggle("border-slate-200", !active);
		});
		monthSelect.value = monthFilter;
		byId("clear-filters").classList.toggle("hidden", consFilter === "all" && monthFilter === "all");
	}

	function render() {
		syncFilterUI();
		renderTotal();
		renderConsulateChart();
		renderMonthChart();
		renderTable();
	}

	function setConsFilter(v: string) {
		consFilter = v;
		visibleLimit = PAGE_SIZE;
		render();
	}
	function setMonthFilter(v: string) {
		monthFilter = v;
		visibleLimit = PAGE_SIZE;
		render();
	}

	function fillMonthSelect() {
		const keys = [...new Set(allRows.map(monthKey))].sort().reverse();
		monthSelect.textContent = "";
		const all = document.createElement("option");
		all.value = "all";
		all.textContent = "All months";
		monthSelect.append(all);
		for (const k of keys) {
			const o = document.createElement("option");
			o.value = k;
			o.textContent = monthLabel(k);
			monthSelect.append(o);
		}
		if (monthFilter !== "all" && !keys.includes(monthFilter)) monthFilter = "all";
	}

	async function loadData() {
		try {
			const url = TABLE_URL + "?select=" + SELECT_COLS + "&order=joining_date.desc,id.desc&limit=1000";
			const res = await fetch(url, { headers: { apikey: SUPABASE_KEY } });
			if (!res.ok) throw new Error("HTTP " + res.status);
			allRows = (await res.json()) as Row[];
			byId("load-error").classList.add("hidden");
			fillMonthSelect();
			render();
		} catch (err) {
			byId("load-error").classList.remove("hidden");
			byId("stat-total").textContent = "\u2014";
			byId("stat-total-sub").textContent = "";
		}
	}

	// Filters
	const consButtons = Array.from(document.querySelectorAll<HTMLButtonElement>(".cons-btn"));
	const monthSelect = byId("month-select") as HTMLSelectElement;
	consButtons.forEach((btn) => btn.addEventListener("click", () => setConsFilter(btn.dataset.cons || "all")));
	monthSelect.addEventListener("change", () => setMonthFilter(monthSelect.value));
	byId("clear-filters").addEventListener("click", () => {
		consFilter = "all";
		monthFilter = "all";
		visibleLimit = PAGE_SIZE;
		render();
	});

	// Search + show more
	(byId("search-input") as HTMLInputElement).addEventListener("input", (e) => {
		searchText = (e.target as HTMLInputElement).value;
		visibleLimit = PAGE_SIZE;
		renderTable();
	});
	byId("more-btn").addEventListener("click", () => {
		visibleLimit += PAGE_SIZE;
		renderTable();
	});

	// Add-yourself form
	const form = byId("tracker-form") as HTMLFormElement;
	const submitBtn = byId("submit-btn") as HTMLButtonElement;
	const msg = byId("form-msg");
	const joinInput = byId("joining_date") as HTMLInputElement;

	const todayUTC = new Date().toISOString().slice(0, 10);
	joinInput.min = "2023-01-01";
	joinInput.max = todayUTC;

	function showMsg(text: string, kind: "ok" | "err" | "") {
		if (!text) {
			msg.className = "hidden";
			msg.textContent = "";
			return;
		}
		msg.className =
			"rounded-lg border p-3 text-sm " +
			(kind === "ok" ? "border-green-200 bg-green-50 text-green-800" : "border-red-200 bg-red-50 text-red-700");
		msg.textContent = text;
	}

	form.addEventListener("submit", async (e) => {
		e.preventDefault();
		showMsg("", "");
		const fd = new FormData(form);

		// Honeypot: real people never see this field
		if (fd.get("website")) {
			showMsg("Thanks! You've been added to the tracker.", "ok");
			return;
		}

		let last = 0;
		try {
			last = Number(localStorage.getItem(LAST_KEY) || 0);
		} catch {}
		if (Date.now() - last < COOLDOWN_MS) {
			showMsg("Please wait a few seconds before sending another report.", "err");
			return;
		}

		const name = String(fd.get("name") || "").replace(/\s+/g, " ").trim();
		const university = String(fd.get("university") || "").replace(/\s+/g, " ").trim();
		const consulate = String(fd.get("consulate") || "");
		const joining = String(fd.get("joining_date") || "");

		if (name.length < 2 || name.length > 80) {
			showMsg("Please enter your name (2 to 80 characters).", "err");
			return;
		}
		if (university.length < 2 || university.length > 120) {
			showMsg("Please enter your university.", "err");
			return;
		}
		if (!consulate) {
			showMsg("Please choose your consulate.", "err");
			return;
		}
		if (!joining) {
			showMsg("Please enter the day you joined the waiting list.", "err");
			return;
		}
		if (joining < "2023-01-01" || joining > todayUTC) {
			showMsg("Your joining date can't be in the future or before 2023.", "err");
			return;
		}

		const payload = { name, university, consulate, joining_date: joining };

		submitBtn.disabled = true;
		submitBtn.textContent = "Sending\u2026";
		try {
			const res = await fetch(TABLE_URL + "?columns=name,university,consulate,joining_date", {
				method: "POST",
				headers: {
					apikey: SUPABASE_KEY,
					"Content-Type": "application/json",
					Prefer: "return=minimal",
				},
				body: JSON.stringify(payload),
			});
			if (!res.ok) throw new Error("HTTP " + res.status);
			try {
				localStorage.setItem(LAST_KEY, String(Date.now()));
			} catch {}
			form.reset();
			showMsg("Thank you! You've been added to the tracker.", "ok");
			await loadData();
		} catch (err) {
			showMsg("We couldn't save your entry. Please check your details and try again later.", "err");
		} finally {
			submitBtn.disabled = false;
			submitBtn.textContent = "Add me to the tracker";
		}
	});

	loadData();
</script>