---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Visa Tracker">
	<div class="mx-auto max-w-2xl py-12 text-center">
		<span class="inline-block rounded-full bg-orange-500 px-4 py-1 text-xs font-semibold uppercase tracking-wide text-white">Coming Soon</span>
		<h1 class="mt-4 text-4xl font-extrabold text-slate-900">Visa Tracker</h1>
		<p class="mt-4 leading-relaxed text-slate-600">
			A community-powered tool to track German student visa timelines &mdash; submit your own
			registration, appointment, and decision dates, and see real average wait times by
			consulate, updated as more students share their experience.
		</p>
		<div class="mt-8 rounded-2xl border border-slate-200 bg-white p-8 shadow-sm">
			<p class="text-sm text-slate-500">We're building this now. Check back soon!</p>
		</div>
	</div>
</Layout>