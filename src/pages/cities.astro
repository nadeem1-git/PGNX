---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Cities">
	<h1 class="text-4xl font-extrabold text-slate-900">City WhatsApp Groups</h1>
	<p class="mt-2 text-slate-600">Connect with other students admitted to the same city.</p>

	<!-- Contact banner -->
	<section class="mt-8">
		<div class="rounded-3xl bg-indigo-700 p-6 text-center text-white shadow-sm">
			<p class="text-sm font-medium sm:text-base">
				If you have been admitted to any of the cities listed below, contact us to join the relevant city WhatsApp Group:
			</p>
			<a href="https://wa.me/491775995266" target="_blank" rel="noopener noreferrer"
				class="mt-4 inline-flex items-center gap-2 rounded-md bg-white px-5 py-2.5 text-sm font-bold text-indigo-700 hover:bg-indigo-50">
				<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
					<path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38a9.9 9.9 0 0 0 4.79 1.22h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.86 9.86 0 0 0 12.04 2z"/>
				</svg>
				+49 177 5995266
			</a>
		</div>
	</section>

	<!-- City groups by state -->
	<section class="mt-10">
		<div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">

			<div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
				<h3 class="flex items-center gap-2 text-lg font-bold text-slate-900">📍 Baden-Württemberg 🇩🇪</h3>
				<ul class="mt-3 space-y-1 text-sm text-slate-600">
					<li>Freiburg</li><li>Heidelberg</li><li>Hohenheim</li><li>Karlsruhe</li>
					<li>Mannheim</li><li>Stuttgart</li><li>Ulm</li>
				</ul>
			</div>

			<div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
				<h3 class="flex items-center gap-2 text-lg font-bold text-slate-900">📍 Bavaria 🇩🇪</h3>
				<ul class="mt-3 space-y-1 text-sm text-slate-600">
					<li>Amberg</li><li>Augsburg</li><li>Bamberg</li><li>Bayreuth</li>
					<li>Ingolstadt</li><li>Munich</li><li>Nuremberg</li><li>Passau</li>
					<li>Regensburg</li><li>Würzburg</li>
				</ul>
			</div>

			<div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
				<h3 class="flex items-center gap-2 text-lg font-bold text-slate-900">📍 Berlin / Brandenburg 🇩🇪</h3>
				<ul class="mt-3 space-y-1 text-sm text-slate-600">
					<li>Berlin</li><li>Cottbus</li><li>Potsdam</li>
				</ul>
			</div>

			<div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
				<h3 class="flex items-center gap-2 text-lg font-bold text-slate-900">📍 Lower Saxony & Anhalt 🇩🇪</h3>
				<ul class="mt-3 space-y-1 text-sm text-slate-600">
					<li>Anhalt</li><li>Braunschweig</li><li>Bremen</li><li>Clausthal</li>
					<li>Emden</li><li>Göttingen</li><li>Hannover</li><li>Hildesheim</li>
					<li>Lüneburg</li><li>Magdeburg</li><li>Oldenburg</li><li>Osnabrück</li>
				</ul>
			</div>

			<div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
				<h3 class="flex items-center gap-2 text-lg font-bold text-slate-900">📍 Hamburg / Northern 🇩🇪</h3>
				<ul class="mt-3 space-y-1 text-sm text-slate-600">
					<li>Hamburg</li><li>Kiel</li><li>Lübeck</li><li>Rostock</li><li>Stralsund</li>
				</ul>
			</div>

			<div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
				<h3 class="flex items-center gap-2 text-lg font-bold text-slate-900">📍 Hesse 🇩🇪</h3>
				<ul class="mt-3 space-y-1 text-sm text-slate-600">
					<li>Darmstadt</li><li>Frankfurt</li><li>Fulda</li><li>Giessen</li>
					<li>Kassel</li><li>Marburg</li>
				</ul>
			</div>

			<div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
				<h3 class="flex items-center gap-2 text-lg font-bold text-slate-900">📍 North Rhine-Westphalia 🇩🇪</h3>
				<ul class="mt-3 space-y-1 text-sm text-slate-600">
					<li>Aachen</li><li>Bielefeld</li><li>Bochum</li><li>Bonn</li>
					<li>Cologne</li><li>Dortmund</li><li>Duisburg-Essen</li><li>Düsseldorf</li>
					<li>Münster</li><li>Paderborn</li><li>Siegen</li>
				</ul>
			</div>

			<div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
				<h3 class="flex items-center gap-2 text-lg font-bold text-slate-900">📍 Rhineland-Palatinate 🇩🇪</h3>
				<ul class="mt-3 space-y-1 text-sm text-slate-600">
					<li>Bingen</li><li>Kaiserslautern</li><li>Koblenz</li><li>Mainz</li>
					<li>Saarbrücken</li><li>Trier</li>
				</ul>
			</div>

			<div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
				<h3 class="flex items-center gap-2 text-lg font-bold text-slate-900">📍 Saxony 🇩🇪</h3>
				<ul class="mt-3 space-y-1 text-sm text-slate-600">
					<li>Chemnitz</li><li>Dresden</li><li>Freiberg</li><li>Leipzig</li><li>Mittweida</li>
				</ul>
			</div>

			<div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
				<h3 class="flex items-center gap-2 text-lg font-bold text-slate-900">📍 Thuringia 🇩🇪</h3>
				<ul class="mt-3 space-y-1 text-sm text-slate-600">
					<li>Erfurt</li><li>Ilmenau</li><li>Jena</li><li>Nordhausen</li><li>Schmalkalden</li>
				</ul>
			</div>

		</div>
	</section>

	<!-- Warning notice -->
	<section class="mb-4 mt-10">
		<div class="rounded-3xl border-2 border-red-200 bg-red-50 p-6 text-center">
			<p class="font-bold text-red-700">
				‼️ Only students who have received admission in any of the cities listed above should contact us. ‼️
			</p>
			<p class="mt-2 text-sm text-red-600">
				❌ If you do not have an admission yet, please wait until your admission is confirmed.
			</p>
			<p class="mt-2 text-sm text-slate-600">Thank you for your cooperation!</p>
		</div>
	</section>
</Layout>