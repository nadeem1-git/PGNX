---
import '../styles/global.css';
const base = import.meta.env.BASE_URL;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Cities | PGNX</title>
	</head>
	<body class="min-h-screen bg-gradient-to-b from-white via-green-50 to-white text-gray-900 relative">

		<div
			class="pointer-events-none fixed inset-0 -z-10"
			style="background-image: radial-gradient(circle, #16653480 1px, transparent 1px); background-size: 24px 24px;"
		></div>

		<div class="pointer-events-none fixed left-1/2 top-40 -z-10 h-[500px] w-[500px] -translate-x-1/2 rounded-full bg-green-300 opacity-20 blur-3xl"></div>

		<!-- Top bar -->
		<header class="relative w-full py-6 px-6 flex items-center justify-end">
			<div class="absolute left-0 top-1/2 h-1 w-full -translate-y-1/2 bg-green-800"></div>
			<a href={base} class="relative z-10 flex flex-col items-center gap-1 bg-white rounded-full p-1">
				<img src={`${base}logo.jpg`} alt="PGNX logo" class="h-20 w-20 rounded-full object-cover border border-green-100" />
			</a>
		</header>

		<!-- Side menu toggle tab -->
		<button
			id="menu-toggle"
			class="fixed left-0 top-28 z-40 flex flex-col items-center gap-2 rounded-r-xl bg-green-800 text-white px-2 py-5 [writing-mode:vertical-rl]"
		>
			<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="[writing-mode:horizontal-tb] rotate-90">
				<path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
				<path d="M9 22V12h6v10"/>
			</svg>
			HOME
		</button>

		<!-- Slide-out side menu -->
		<nav
			id="side-menu"
			class="fixed left-0 top-0 h-full w-64 -translate-x-full bg-green-900 text-white p-6 transition-transform duration-300 z-50"
		>
			<button id="menu-close" class="mb-6 text-sm text-green-200">&#10005; Close</button>
			<ul class="space-y-4 font-medium">
				<li><a href={base} class="hover:text-green-300">Home</a></li>
				<li><a href={`${base}admission`} class="hover:text-green-300">Admission</a></li>
				<li><a href={`${base}visa`} class="hover:text-green-300">Visa</a></li>
				<li><a href={`${base}resources`} class="hover:text-green-300">Resources</a></li>
				<li><a href={`${base}cities`} class="hover:text-green-300">Cities</a></li>
				<li><a href={`${base}about`} class="hover:text-green-300">About Us</a></li>
				<li><a href={`${base}contact`} class="hover:text-green-300">Contact</a></li>
			</ul>
		</nav>

		<!-- Main content -->
		<main class="px-6 py-12 max-w-5xl mx-auto">

			<a href={base} class="text-sm text-green-700 hover:text-green-900">&larr; Back to Home</a>

			<h1 class="mt-4 text-4xl font-extrabold text-green-800">City WhatsApp Groups</h1>
			<p class="mt-2 text-gray-600">Connect with other students admitted to the same city.</p>

			<!-- Contact banner -->
			<section class="mt-8">
				<div class="rounded-3xl bg-green-800 text-white p-6 text-center shadow-sm">
					<p class="text-sm sm:text-base font-medium">
						If you have been admitted to any of the cities listed below, contact us to join the relevant city WhatsApp Group:
					</p>
					<a href="https://wa.me/491775995266" target="_blank" rel="noopener noreferrer"
						class="mt-4 inline-flex items-center gap-2 rounded-md bg-white text-green-800 text-sm font-bold px-5 py-2.5 hover:bg-green-50">
						<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
							<path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38a9.9 9.9 0 0 0 4.79 1.22h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.86 9.86 0 0 0 12.04 2z"/>
						</svg>
						+49 177 5995266
					</a>
				</div>
			</section>

			<!-- City groups by state -->
			<section class="mt-10">
				<div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">

					<div class="rounded-3xl bg-white/60 backdrop-blur-sm border border-green-100 shadow-sm p-6">
						<h3 class="text-lg font-bold text-green-800 flex items-center gap-2">📍 Baden-Württemberg 🇩🇪</h3>
						<ul class="mt-3 text-sm text-gray-700 space-y-1">
							<li>Freiburg</li><li>Heidelberg</li><li>Hohenheim</li><li>Karlsruhe</li>
							<li>Mannheim</li><li>Stuttgart</li><li>Ulm</li>
						</ul>
					</div>

					<div class="rounded-3xl bg-white/60 backdrop-blur-sm border border-green-100 shadow-sm p-6">
						<h3 class="text-lg font-bold text-green-800 flex items-center gap-2">📍 Bavaria 🇩🇪</h3>
						<ul class="mt-3 text-sm text-gray-700 space-y-1">
							<li>Amberg</li><li>Augsburg</li><li>Bamberg</li><li>Bayreuth</li>
							<li>Ingolstadt</li><li>Munich</li><li>Nuremberg</li><li>Passau</li>
							<li>Regensburg</li><li>Würzburg</li>
						</ul>
					</div>

					<div class="rounded-3xl bg-white/60 backdrop-blur-sm border border-green-100 shadow-sm p-6">
						<h3 class="text-lg font-bold text-green-800 flex items-center gap-2">📍 Berlin / Brandenburg 🇩🇪</h3>
						<ul class="mt-3 text-sm text-gray-700 space-y-1">
							<li>Berlin</li><li>Cottbus</li><li>Potsdam</li>
						</ul>
					</div>

					<div class="rounded-3xl bg-white/60 backdrop-blur-sm border border-green-100 shadow-sm p-6">
						<h3 class="text-lg font-bold text-green-800 flex items-center gap-2">📍 Lower Saxony & Anhalt 🇩🇪</h3>
						<ul class="mt-3 text-sm text-gray-700 space-y-1">
							<li>Anhalt</li><li>Braunschweig</li><li>Bremen</li><li>Clausthal</li>
							<li>Emden</li><li>Göttingen</li><li>Hannover</li><li>Hildesheim</li>
							<li>Lüneburg</li><li>Magdeburg</li><li>Oldenburg</li><li>Osnabrück</li>
						</ul>
					</div>

					<div class="rounded-3xl bg-white/60 backdrop-blur-sm border border-green-100 shadow-sm p-6">
						<h3 class="text-lg font-bold text-green-800 flex items-center gap-2">📍 Hamburg / Northern 🇩🇪</h3>
						<ul class="mt-3 text-sm text-gray-700 space-y-1">
							<li>Hamburg</li><li>Kiel</li><li>Lübeck</li><li>Rostock</li><li>Stralsund</li>
						</ul>
					</div>

					<div class="rounded-3xl bg-white/60 backdrop-blur-sm border border-green-100 shadow-sm p-6">
						<h3 class="text-lg font-bold text-green-800 flex items-center gap-2">📍 Hesse 🇩🇪</h3>
						<ul class="mt-3 text-sm text-gray-700 space-y-1">
							<li>Darmstadt</li><li>Frankfurt</li><li>Fulda</li><li>Giessen</li>
							<li>Kassel</li><li>Marburg</li>
						</ul>
					</div>

					<div class="rounded-3xl bg-white/60 backdrop-blur-sm border border-green-100 shadow-sm p-6">
						<h3 class="text-lg font-bold text-green-800 flex items-center gap-2">📍 North Rhine-Westphalia 🇩🇪</h3>
						<ul class="mt-3 text-sm text-gray-700 space-y-1">
							<li>Aachen</li><li>Bielefeld</li><li>Bochum</li><li>Bonn</li>
							<li>Cologne</li><li>Dortmund</li><li>Duisburg-Essen</li><li>Düsseldorf</li>
							<li>Münster</li><li>Paderborn</li><li>Siegen</li>
						</ul>
					</div>

					<div class="rounded-3xl bg-white/60 backdrop-blur-sm border border-green-100 shadow-sm p-6">
						<h3 class="text-lg font-bold text-green-800 flex items-center gap-2">📍 Rhineland-Palatinate 🇩🇪</h3>
						<ul class="mt-3 text-sm text-gray-700 space-y-1">
							<li>Bingen</li><li>Kaiserslautern</li><li>Koblenz</li><li>Mainz</li>
							<li>Saarbrücken</li><li>Trier</li>
						</ul>
					</div>

					<div class="rounded-3xl bg-white/60 backdrop-blur-sm border border-green-100 shadow-sm p-6">
						<h3 class="text-lg font-bold text-green-800 flex items-center gap-2">📍 Saxony 🇩🇪</h3>
						<ul class="mt-3 text-sm text-gray-700 space-y-1">
							<li>Chemnitz</li><li>Dresden</li><li>Freiberg</li><li>Leipzig</li><li>Mittweida</li>
						</ul>
					</div>

					<div class="rounded-3xl bg-white/60 backdrop-blur-sm border border-green-100 shadow-sm p-6">
						<h3 class="text-lg font-bold text-green-800 flex items-center gap-2">📍 Thuringia 🇩🇪</h3>
						<ul class="mt-3 text-sm text-gray-700 space-y-1">
							<li>Erfurt</li><li>Ilmenau</li><li>Jena</li><li>Nordhausen</li><li>Schmalkalden</li>
						</ul>
					</div>

				</div>
			</section>

			<!-- Warning notice -->
			<section class="mt-10 mb-4">
				<div class="rounded-3xl border-2 border-red-200 bg-red-50 p-6 text-center">
					<p class="font-bold text-red-700">
						‼️ Only students who have received admission in any of the cities listed above should contact us. ‼️
					</p>
					<p class="mt-2 text-sm text-red-600">
						❌ If you do not have an admission yet, please wait until your admission is confirmed.
					</p>
					<p class="mt-2 text-sm text-gray-600">Thank you for your cooperation!</p>
				</div>
			</section>

		</main>

		<!-- Footer -->
		<footer class="mt-12 border-t border-green-100 py-6 px-6 flex flex-col sm:flex-row items-center justify-between gap-3 text-sm text-gray-500 max-w-5xl mx-auto">
			<p>&copy; 2025 PGNX &mdash; Pakistan Germany Nexus. All rights reserved.</p>
			<div class="flex gap-4">
				<a href="#" aria-label="Facebook" class="hover:text-green-700">FB</a>
				<a href="#" aria-label="Instagram" class="hover:text-green-700">IG</a>
				<a href="#" aria-label="WhatsApp" class="hover:text-green-700">WA</a>
			</div>
		</footer>

		<script>
			const toggle = document.getElementById("menu-toggle");
			const menu = document.getElementById("side-menu");
			const close = document.getElementById("menu-close");

			toggle?.addEventListener("click", () => {
				menu?.classList.remove("-translate-x-full");
			});
			close?.addEventListener("click", () => {
				menu?.classList.add("-translate-x-full");
			});
		</script>
	</body>
</html>