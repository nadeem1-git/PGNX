---
import Layout from '../layouts/Layout.astro';
---

<Layout title="German Language">
	<h1 class="text-4xl font-extrabold text-slate-900">German Language</h1>
	<p class="mt-2 text-slate-600">Resources and guidance for learning German.</p>

	<!-- YouTube channel -->
	<section class="mt-10 rounded-2xl border border-slate-200 bg-white p-8 text-center shadow-sm">
		<div class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-indigo-50 text-indigo-600">
			<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
				<path d="M22.54 6.42a2.78 2.78 0 0 0-1.94-2C18.88 4 12 4 12 4s-6.88 0-8.6.46a2.78 2.78 0 0 0-1.94 2A29 29 0 0 0 1 11.75a29 29 0 0 0 .46 5.33A2.78 2.78 0 0 0 3.4 19c1.72.46 8.6.46 8.6.46s6.88 0 8.6-.46a2.78 2.78 0 0 0 1.94-2 29 29 0 0 0 .46-5.25 29 29 0 0 0-.46-5.33z"/>
				<polygon points="9.75 15.02 15.5 11.75 9.75 8.48 9.75 15.02"/>
			</svg>
		</div>
		<h2 class="mt-4 text-xl font-bold text-slate-900">PAK GERMAN NEXUS on YouTube</h2>
		<p class="mt-2 text-slate-600">Video lessons and guidance to help you learn German for your journey.</p>
		<a href="https://www.youtube.com/@PAKGERMANNEXUS" target="_blank" rel="noopener noreferrer"
			class="mt-6 inline-flex items-center gap-2 rounded-md bg-indigo-700 px-5 py-2.5 text-sm font-semibold text-white hover:bg-indigo-800">
			Visit Our Channel &rarr;
		</a>
	</section>

	<!-- Free German Materials -->
	<section class="mt-6 rounded-2xl border border-slate-200 bg-white p-8 shadow-sm">
		<div class="text-center">
			<span class="inline-block rounded-full bg-orange-500 px-4 py-1 text-xs font-semibold uppercase tracking-wide text-white">A1 &bull; A2 &bull; B1</span>
			<h2 class="mt-3 text-xl font-bold text-slate-900">Free German Materials</h2>
			<p class="mt-1 text-sm text-slate-600">Everything you need to prepare &mdash; free to access.</p>
		</div>

		<ul class="mt-6 grid gap-3 text-slate-600 sm:grid-cols-2">
			<li class="flex items-center gap-2"><span>📚</span> Course Books</li>
			<li class="flex items-center gap-2"><span>📝</span> Workbooks &amp; Practice Resources</li>
			<li class="flex items-center gap-2"><span>📄</span> Past Papers &amp; Exam Preparation</li>
			<li class="flex items-center gap-2"><span>🧠</span> Grammar + Vocabulary</li>
			<li class="flex items-center gap-2"><span>🎧</span> Listening Practice</li>
		</ul>

		<div class="mt-6 text-center">
			<a href="https://drive.google.com/drive/folders/1XNXwkeErdqkk_nD32DlfA8zgv6ZEEGvk" target="_blank" rel="noopener noreferrer"
				class="inline-flex items-center gap-2 rounded-md bg-indigo-700 px-5 py-2.5 text-sm font-semibold text-white hover:bg-indigo-800">
				📌 Open Materials Drive &rarr;
			</a>
		</div>
	</section>
</Layout>