---
import '../styles/global.css';
const base = import.meta.env.BASE_URL;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>German Language | PGNX</title>
	</head>
	<body class="min-h-screen bg-gradient-to-b from-white via-green-50 to-white text-gray-900 relative">

		<div
			class="pointer-events-none fixed inset-0 -z-10"
			style="background-image: radial-gradient(circle, #16653480 1px, transparent 1px); background-size: 24px 24px;"
		></div>

		<!-- Top bar -->
		<header class="relative w-full py-6 px-6 flex items-center justify-end">
			<div class="absolute left-0 top-1/2 h-1 w-full -translate-y-1/2 bg-green-800"></div>
			<a href={base} class="relative z-10 flex flex-col items-center gap-1 bg-white rounded-full p-1">
				<img src={`${base}logo.jpg`} alt="PGNX logo" class="h-20 w-20 rounded-full object-cover border border-green-100" />
			</a>
		</header>

		<!-- Side menu toggle tab -->
		<button
			id="menu-toggle"
			class="fixed left-0 top-28 z-40 flex flex-col items-center gap-2 rounded-r-xl bg-green-800 text-white px-2 py-5 [writing-mode:vertical-rl]"
		>
			<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="[writing-mode:horizontal-tb] rotate-90">
				<path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
				<path d="M9 22V12h6v10"/>
			</svg>
			HOME
		</button>

		<!-- Slide-out side menu -->
		<nav
			id="side-menu"
			class="fixed left-0 top-0 h-full w-64 -translate-x-full bg-green-900 text-white p-6 transition-transform duration-300 z-50"
		>
			<button id="menu-close" class="mb-6 text-sm text-green-200">&#10005; Close</button>
			<ul class="space-y-4 font-medium">
				<li><a href={base} class="hover:text-green-300">Home</a></li>
				<li><a href={`${base}admission`} class="hover:text-green-300">Admission</a></li>
				<li><a href={`${base}visa`} class="hover:text-green-300">Visa</a></li>
				<li><a href={`${base}resources`} class="hover:text-green-300">Resources</a></li>
				<li><a href={`${base}about`} class="hover:text-green-300">About Us</a></li>
				<li><a href={`${base}contact`} class="hover:text-green-300">Contact</a></li>
			</ul>
		</nav>

		<!-- Main content -->
		<main class="px-6 py-12 max-w-3xl mx-auto">
			<a href={base} class="text-sm text-green-700 hover:text-green-900">&larr; Back to Home</a>

			<h1 class="mt-4 text-4xl font-extrabold text-green-800">German Language</h1>
			<p class="mt-2 text-gray-600">Resources and guidance for learning German.</p>

			<!-- YouTube channel -->
			<section class="mt-10 rounded-2xl bg-white/60 backdrop-blur-sm border border-green-100 shadow-sm p-8 text-center">
				<div class="mx-auto h-12 w-12 rounded-full bg-green-100 flex items-center justify-center text-green-700">
					<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
						<path d="M22.54 6.42a2.78 2.78 0 0 0-1.94-2C18.88 4 12 4 12 4s-6.88 0-8.6.46a2.78 2.78 0 0 0-1.94 2A29 29 0 0 0 1 11.75a29 29 0 0 0 .46 5.33A2.78 2.78 0 0 0 3.4 19c1.72.46 8.6.46 8.6.46s6.88 0 8.6-.46a2.78 2.78 0 0 0 1.94-2 29 29 0 0 0 .46-5.25 29 29 0 0 0-.46-5.33z"/>
						<polygon points="9.75 15.02 15.5 11.75 9.75 8.48 9.75 15.02"/>
					</svg>
				</div>
				<h2 class="mt-4 text-xl font-bold text-green-800">PAK GERMAN NEXUS on YouTube</h2>
				<p class="mt-2 text-gray-600">Video lessons and guidance to help you learn German for your journey.</p>
				<a href="https://www.youtube.com/@PAKGERMANNEXUS" target="_blank" rel="noopener noreferrer"
					class="mt-6 inline-flex items-center gap-2 rounded-md bg-green-800 text-white text-sm font-semibold px-5 py-2.5 hover:bg-green-900">
					Visit Our Channel &rarr;
				</a>
			</section>

			<!-- Free German Materials -->
			<section class="mt-6 rounded-2xl bg-white/60 backdrop-blur-sm border border-green-100 shadow-sm p-8">
				<div class="text-center">
					<span class="inline-block rounded-full bg-gold-100 px-4 py-1 text-xs font-semibold uppercase tracking-wide text-gold-800">A1 &bull; A2 &bull; B1</span>
					<h2 class="mt-3 text-xl font-bold text-green-800">Free German Materials</h2>
					<p class="mt-1 text-sm text-gray-600">Everything you need to prepare &mdash; free to access.</p>
				</div>

				<ul class="mt-6 grid gap-3 sm:grid-cols-2 text-gray-700">
					<li class="flex items-center gap-2"><span>📚</span> Course Books</li>
					<li class="flex items-center gap-2"><span>📝</span> Workbooks &amp; Practice Resources</li>
					<li class="flex items-center gap-2"><span>📄</span> Past Papers &amp; Exam Preparation</li>
					<li class="flex items-center gap-2"><span>🧠</span> Grammar + Vocabulary</li>
					<li class="flex items-center gap-2"><span>🎧</span> Listening Practice</li>
				</ul>

				<div class="mt-6 text-center">
					<a href="https://drive.google.com/drive/folders/1XNXwkeErdqkk_nD32DlfA8zgv6ZEEGvk" target="_blank" rel="noopener noreferrer"
						class="inline-flex items-center gap-2 rounded-md bg-green-800 text-white text-sm font-semibold px-5 py-2.5 hover:bg-green-900">
						📌 Open Materials Drive &rarr;
					</a>
				</div>
			</section>
		</main>

		<!-- Footer -->
		<footer class="mt-12 border-t border-green-100 py-6 px-6 flex flex-col sm:flex-row items-center justify-between gap-3 text-sm text-gray-500 max-w-3xl mx-auto">
			<p>&copy; 2025 PGNX &mdash; Pakistan Germany Nexus. All rights reserved.</p>
			<div class="flex gap-4">
				<a href="#" aria-label="Facebook" class="hover:text-green-700">FB</a>
				<a href="#" aria-label="Instagram" class="hover:text-green-700">IG</a>
				<a href="#" aria-label="WhatsApp" class="hover:text-green-700">WA</a>
			</div>
		</footer>

		<script>
			const toggle = document.getElementById("menu-toggle");
			const menu = document.getElementById("side-menu");
			const close = document.getElementById("menu-close");
			toggle?.addEventListener("click", () => {
				menu?.classList.remove("-translate-x-full");
			});
			close?.addEventListener("click", () => {
				menu?.classList.add("-translate-x-full");
			});
		</script>
	</body>
</html>