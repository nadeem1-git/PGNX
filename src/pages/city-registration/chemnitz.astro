---
import Layout from '../../layouts/Layout.astro';
const base = import.meta.env.BASE_URL;
---

<Layout title="Chemnitz City Registration">
	<a href={`${base}city-registration`} class="text-sm text-indigo-600 hover:text-indigo-700">Back to City Registration</a>

	<h1 class="mt-4 text-4xl font-extrabold text-slate-900">Chemnitz &mdash; City Registration (Anmeldung)</h1>
	<p class="mt-2 text-slate-600">Everything you need to register your address after moving to Chemnitz.</p>

	<!-- In This Guide -->
	<nav class="mt-8 rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
		<p class="text-xs font-semibold uppercase tracking-wide text-indigo-700">In This Guide</p>
		<ul class="mt-3 flex flex-wrap gap-x-6 gap-y-2 text-sm">
			<li><a href="#why-it-matters" class="text-indigo-700 hover:underline">Why It Matters</a></li>
			<li><a href="#where-to-register" class="text-indigo-700 hover:underline">Where to Register</a></li>
			<li><a href="#documents-required" class="text-indigo-700 hover:underline">Documents Required</a></li>
			<li><a href="#steps-to-register" class="text-indigo-700 hover:underline">Steps to Register</a></li>
			<li><a href="#after-registration" class="text-indigo-700 hover:underline">After Registration</a></li>
		</ul>
	</nav>

	<!-- Why it matters -->
	<section id="why-it-matters" class="mt-6 rounded-2xl border border-slate-200 bg-white p-8 shadow-sm">
		<h2 class="text-2xl font-bold text-slate-900">Why City Registration Matters</h2>
		<p class="mt-4 leading-relaxed text-slate-600">
			Once you move into your accommodation in Germany, you're required to register your address at
			the local city office within <strong>14 days</strong>. This process is called <strong>Anmeldung</strong>.
		</p>
		<p class="mt-4 leading-relaxed text-slate-600">
			You'll need your registration certificate before you can open a bank account, receive your
			Tax ID, or apply for a residence permit extension &mdash; so it's one of the first things to
			sort out after arriving.
		</p>
		<div class="mt-6 rounded-lg border border-indigo-100 bg-indigo-50 p-4 text-sm text-indigo-800">
			<strong>Note:</strong> Without completing your Anmeldung, none of the above are possible, and you
			will not be considered legally resident.
		</div>
	</section>

	<!-- Where to register -->
	<section id="where-to-register" class="mt-6 rounded-2xl border border-slate-200 bg-white p-8 shadow-sm">
		<h2 class="text-2xl font-bold text-slate-900">Where to Register</h2>
		<p class="mt-4 leading-relaxed text-slate-600">
			Registration is handled at the <strong>Bürgeramt (Citizens' Office)</strong> in Chemnitz.
		</p>
		<ul class="mt-4 space-y-2 text-slate-600">
			<li><strong>Address:</strong> Düsseldorfer Platz 1, 09111 Chemnitz</li>
			<li><strong>Phone:</strong> +49 (0)371/115</li>
			<li><strong>Email:</strong> meldebehoerde@stadt-chemnitz.de</li>
			<li><strong>Website:</strong> <a href="https://www.chemnitz.de/chemnitz/de/buerger-rathaus/buergerservice/anmeldung/index.html" target="_blank" rel="noopener noreferrer" class="text-indigo-600 underline hover:text-indigo-700">City of Chemnitz &ndash; Anmeldung</a></li>
			<li><strong>Book appointment:</strong> <a href="http://www-19.stadt-chemnitz.de/" target="_blank" rel="noopener noreferrer" class="text-indigo-600 underline hover:text-indigo-700">www-19.stadt-chemnitz.de</a></li>
		</ul>

		<h3 class="mt-6 font-semibold text-slate-800">Office Hours</h3>
		<ul class="mt-2 space-y-1 text-sm text-slate-600">
			<li>Monday: 08:30 &ndash; 12:00</li>
			<li>Tuesday: 08:30 &ndash; 18:00</li>
			<li>Wednesday: Closed</li>
			<li>Thursday: 08:30 &ndash; 18:00</li>
			<li>Friday: 08:30 &ndash; 12:00</li>
			<li>Saturday: 09:00 &ndash; 13:00</li>
		</ul>
	</section>

	<!-- Documents required -->
	<section id="documents-required" class="mt-6 rounded-2xl border border-slate-200 bg-white p-8 shadow-sm">
		<h2 class="text-2xl font-bold text-slate-900">Documents Required</h2>
		<ul class="mt-4 list-inside list-disc space-y-2 text-slate-600">
			<li>Passport</li>
			<li>Visa or residence permit</li>
			<li>Signed rental contract / lease agreement</li>
		</ul>
	</section>

	<!-- Steps -->
	<section id="steps-to-register" class="mt-6 rounded-2xl border border-slate-200 bg-white p-8 shadow-sm">
		<h2 class="text-2xl font-bold text-slate-900">Steps to Register</h2>
		<ol class="mt-4 space-y-4 text-slate-600">
			<li><strong>1. Book an appointment</strong> using the online booking link above, or go as a walk-in early in the morning at Düsseldorfer Platz 1, 09111 Chemnitz.</li>
			<li><strong>2. Gather your documents</strong> and bring them with you to the appointment.</li>
			<li><strong>3. Attend on time.</strong> If you booked online, you'll get a confirmation email with your appointment details.</li>
			<li><strong>4. Receive your registration certificate</strong> (Meldebescheinigung) at the end of the appointment.</li>
		</ol>
		<div class="mt-6 rounded-lg border border-indigo-100 bg-indigo-50 p-4 text-sm text-indigo-800">
			<strong>Tip:</strong> Appointment slots can fill up quickly &mdash; book as early as possible or try walking in right when the office opens.
		</div>
	</section>

	<!-- After registration -->
	<section id="after-registration" class="mt-6 rounded-2xl border border-slate-200 bg-white p-8 shadow-sm">
		<h2 class="text-2xl font-bold text-slate-900">After Registration</h2>
		<p class="mt-4 leading-relaxed text-slate-600">
			Once you're registered, your <strong>Tax ID (Steuer-ID)</strong> will be sent to your address by
			post automatically, usually within 2&ndash;3 weeks.
		</p>
	</section>
</Layout>