---
import Layout from '../../layouts/Layout.astro';
const base = import.meta.env.BASE_URL;
---

<Layout title="City Registration">
	<div class="overflow-hidden rounded-2xl bg-slate-900 text-white shadow-xl">
		<div class="px-8 pt-8">
			<p class="text-sm text-indigo-300">City Registration &rsaquo; Choose a city</p>
			<h1 class="mt-1 text-2xl font-bold">Anmeldung Guides by City</h1>
		</div>

		<ul class="mt-6 border-t border-white/10">
			<li class="border-b border-white/10">
				<a href={`${base}city-registration/chemnitz`} class="menu-row group flex items-center justify-between px-8 py-5 text-lg text-slate-200 transition-colors hover:bg-white/5 hover:text-white">
					<span class="menu-label">Chemnitz</span>
					<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-indigo-300 transition-transform group-hover:translate-x-1">
						<path d="M9 6l6 6-6 6"></path>
					</svg>
				</a>
			</li>
		</ul>

		<p class="px-8 py-5 text-sm text-slate-400">
			More cities coming soon.
		</p>
	</div>

	<style>
		.menu-label {
			position: relative;
		}
		.menu-row:hover .menu-label::after {
			content: "";
			position: absolute;
			left: 0;
			right: 0;
			bottom: -4px;
			height: 1px;
			background: currentColor;
		}
	</style>
</Layout>