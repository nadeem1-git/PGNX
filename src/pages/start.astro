---
import Layout from '../layouts/Layout.astro';
import ProgramCard from '../components/ProgramCard.astro';
import programsData from '../data/masterPrograms.json';

const base = import.meta.env.BASE_URL;

type Program = {
  id: string;
  degree: string;
  category: string;
  university: string;
  course: string;
  ownership: 'Public' | 'Private';
  link: string | null;
  requirements: string;
};

const programs = (programsData as Program[]).slice().sort((a, b) => a.course.localeCompare(b.course));

const categoryCounts = new Map<string, number>();
for (const p of programs) {
  categoryCounts.set(p.category, (categoryCounts.get(p.category) ?? 0) + 1);
}
const categories = [...categoryCounts.entries()].sort((a, b) => a[0].localeCompare(b[0]));
---

<Layout title="Find Your Path">
	<div class="mx-auto max-w-5xl">
		<h1 class="text-center text-4xl font-extrabold text-slate-900">Find Your Path</h1>
		<p class="mt-2 text-center text-slate-600">Pick your field of study and see every Master's program in it.</p>

		<!-- Step: choose a field -->
		<section id="field-picker" class="mt-10">
			<h2 class="text-center text-xl font-bold text-slate-900">What field do you want to study?</h2>
			<div class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
				{categories.map(([cat, count]) => (
					<button type="button" data-cat={cat} class="field-btn rounded-xl border border-slate-200 bg-white px-4 py-3.5 text-left shadow-sm transition-colors hover:border-indigo-400 hover:bg-indigo-50">
						<span class="block text-sm font-semibold text-slate-900">{cat}</span>
						<span class="mt-0.5 block text-xs text-slate-500">{count} {count === 1 ? "program" : "programs"}</span>
					</button>
				))}
			</div>
		</section>

		<!-- Results -->
		<section id="results" class="mt-10 hidden">
			<div class="flex flex-wrap items-end justify-between gap-3">
				<div>
					<h2 id="results-title" class="text-2xl font-bold text-slate-900"></h2>
					<p id="results-count" class="mt-1 text-sm text-slate-500"></p>
				</div>
				<button id="change-btn" type="button" class="rounded-full border border-slate-300 px-4 py-2 text-sm font-medium text-indigo-600 hover:bg-indigo-50">
					Change field
				</button>
			</div>

			<!-- Search within the chosen field -->
			<div class="relative mt-5">
				<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="pointer-events-none absolute left-4 top-1/2 -translate-y-1/2 text-slate-400">
					<circle cx="11" cy="11" r="7" />
					<path d="M21 21l-4.3-4.3" />
				</svg>
				<input
					id="program-search"
					type="search"
					placeholder="Search by course or university&hellip;"
					autocomplete="off"
					aria-label="Search programs in this field"
					class="w-full rounded-full border border-slate-200 bg-white py-3 pl-11 pr-5 text-sm shadow-sm focus:outline-none focus:ring-2 focus:ring-indigo-400"
				/>
			</div>

			<div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
				{programs.map((p) => (
					<div class="contents" data-search={`${p.course} ${p.university}`}>
						<ProgramCard
							course={p.course}
							university={p.university}
							ownership={p.ownership}
							requirements={p.requirements}
							link={p.link}
							category={p.category}
						/>
					</div>
				))}
			</div>

			<p id="no-results" class="mt-6 hidden rounded-2xl border border-dashed border-slate-300 bg-white p-8 text-center text-slate-500">
				No programs match your search. Try a different word, or clear the search box.
			</p>

			<p class="mt-8 text-center text-sm text-slate-500">
				Want to search by university or filter by public or private?
				<a href={`${base}universities/masters`} class="text-indigo-600 underline">Browse the full Master's list</a>.
			</p>
		</section>
	</div>
</Layout>

<script>
	const picker = document.getElementById("field-picker") as HTMLElement;
	const results = document.getElementById("results") as HTMLElement;
	const title = document.getElementById("results-title") as HTMLElement;
	const count = document.getElementById("results-count") as HTMLElement;
	const searchBox = document.getElementById("program-search") as HTMLInputElement;
	const noResults = document.getElementById("no-results") as HTMLElement;
	const cards = Array.from(document.querySelectorAll<HTMLElement>(".program-card"));
	const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>(".field-btn"));

	let currentCat = "";

	// Lower-case and drop accents so "munchen" finds "München"
	const norm = (t: string) =>
		t
			.toLowerCase()
			.normalize("NFD")
			.replace(/[\u0300-\u036f]/g, "");

	// Each card's course + university text, stored on its wrapper
	const searchText = new Map<HTMLElement, string>();
	for (const card of cards) {
		const wrap = card.closest<HTMLElement>("[data-search]");
		searchText.set(card, norm(wrap?.dataset.search || card.textContent || ""));
	}

	function applyFilters() {
		const words = norm(searchBox.value).split(/\s+/).filter(Boolean);
		let n = 0;
		for (const card of cards) {
			const text = searchText.get(card) || "";
			const match = card.dataset.category === currentCat && words.every((w) => text.includes(w));
			card.classList.toggle("hidden", !match);
			if (match) n++;
		}
		const label = n + " Master's program" + (n === 1 ? "" : "s");
		count.textContent = words.length ? label + " found" : label + ", sorted A to Z";
		noResults.classList.toggle("hidden", n > 0);
	}

	function showField(cat: string, updateHash: boolean) {
		currentCat = cat;
		searchBox.value = "";
		title.textContent = cat;
		applyFilters();
		picker.classList.add("hidden");
		results.classList.remove("hidden");
		if (updateHash) history.replaceState(null, "", "#" + encodeURIComponent(cat));
		window.scrollTo({ top: 0 });
	}

	function showPicker() {
		results.classList.add("hidden");
		picker.classList.remove("hidden");
		searchBox.value = "";
		history.replaceState(null, "", location.pathname + location.search);
		window.scrollTo({ top: 0 });
	}

	buttons.forEach((btn) => btn.addEventListener("click", () => showField(btn.dataset.cat || "", true)));
	document.getElementById("change-btn")?.addEventListener("click", showPicker);
	searchBox.addEventListener("input", applyFilters);

	// Open straight to a field if the link has one, e.g. .../start/#Computer%20Science
	try {
		const wanted = decodeURIComponent(location.hash.slice(1));
		if (wanted && buttons.some((b) => b.dataset.cat === wanted)) showField(wanted, false);
	} catch {}
</script>