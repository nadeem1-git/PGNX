---
import Layout from '../layouts/Layout.astro';
const base = import.meta.env.BASE_URL;
---

<Layout title="Find Your Path">
	<div class="mx-auto max-w-2xl">
		<h1 class="text-center text-4xl font-extrabold text-slate-900">Find Your Path</h1>
		<p class="mt-2 text-center text-slate-600">Answer a few questions and we'll help point you in the right direction.</p>

		<!-- Progress -->
		<div class="mt-8 flex items-center justify-center gap-2">
			<span class="progress-dot h-2 w-8 rounded-full bg-indigo-600" data-step="degree"></span>
			<span class="progress-dot h-2 w-8 rounded-full bg-indigo-100" data-step="education"></span>
			<span class="progress-dot h-2 w-8 rounded-full bg-indigo-100" data-step="language"></span>
			<span class="progress-dot h-2 w-8 rounded-full bg-indigo-100" data-step="field"></span>
		</div>

		<!-- Step: Degree -->
		<section id="step-degree" class="step mt-8 rounded-2xl border border-slate-200 bg-white p-8 shadow-sm">
			<h2 class="text-center text-xl font-bold text-slate-900">Are you applying for a Bachelor's or Master's?</h2>
			<div class="mt-6 grid gap-4 sm:grid-cols-2">
				<button class="degree-btn rounded-xl border border-slate-200 bg-white p-6 text-center font-semibold text-slate-900 hover:border-indigo-400" data-degree="bachelors">
					Bachelor's
				</button>
				<button class="degree-btn rounded-xl border border-slate-200 bg-white p-6 text-center font-semibold text-slate-900 hover:border-indigo-400" data-degree="masters">
					Master's
				</button>
			</div>
		</section>

		<!-- Step: Education check -->
		<section id="step-education" class="step hidden mt-8 rounded-2xl border border-slate-200 bg-white p-8 shadow-sm">
			<h2 id="education-question" class="text-center text-xl font-bold text-slate-900"></h2>
			<div class="mt-6 grid gap-4 sm:grid-cols-2">
				<button class="edu-btn rounded-xl border border-slate-200 bg-white p-6 text-center font-semibold text-slate-900 hover:border-indigo-400" data-answer="yes">
					Yes
				</button>
				<button class="edu-btn rounded-xl border border-slate-200 bg-white p-6 text-center font-semibold text-slate-900 hover:border-indigo-400" data-answer="no">
					No
				</button>
			</div>
		</section>

		<!-- Step: Not eligible -->
		<section id="step-not-eligible" class="step hidden mt-8 rounded-2xl border border-slate-200 bg-white p-8 text-center shadow-sm">
			<h2 class="text-xl font-bold text-slate-900">Not quite there yet</h2>
			<p class="mt-4 leading-relaxed text-slate-600">
				Based on your answer, you don't currently meet the education requirement for this degree
				level. Check our <a href={`${base}admission`} class="text-indigo-600 underline">Admission page</a>{" "}
				for ways to close that gap.
			</p>
			<button id="restart-btn" class="mt-6 rounded-md bg-indigo-700 px-6 py-2.5 font-semibold text-white hover:bg-indigo-800">
				Start Over
			</button>
		</section>

		<!-- Step: Language -->
		<section id="step-language" class="step hidden mt-8 rounded-2xl border border-slate-200 bg-white p-8 shadow-sm">
			<h2 class="text-center text-xl font-bold text-slate-900">Your language levels</h2>
			<div class="mt-6 space-y-5">
				<div>
					<label class="block text-sm font-semibold text-slate-700">English (IELTS band)</label>
					<select id="ielts-select" class="mt-1.5 w-full rounded-md border border-slate-200 bg-white px-4 py-2.5 text-sm">
						<option value="">Select your band</option>
						<option>0</option><option>1</option><option>2</option><option>3</option>
						<option>3.5</option><option>4</option><option>4.5</option><option>5</option>
						<option>5.5</option><option>6</option><option>6.5</option><option>7</option>
						<option>7.5</option><option>8</option><option>8.5</option><option>9</option>
					</select>
				</div>
				<div>
					<label class="block text-sm font-semibold text-slate-700">German level</label>
					<select id="german-select" class="mt-1.5 w-full rounded-md border border-slate-200 bg-white px-4 py-2.5 text-sm">
						<option value="">Select your level</option>
						<option>A1</option><option>A2</option><option>B1</option>
						<option>B2</option><option>C1</option><option>C2</option>
						<option value="none">None yet</option>
					</select>
				</div>
			</div>
			<button id="language-continue" class="mt-6 w-full rounded-md bg-indigo-700 px-6 py-2.5 font-semibold text-white hover:bg-indigo-800">
				Continue
			</button>
		</section>

		<!-- Step: Field of study -->
		<section id="step-field" class="step hidden mt-8 rounded-2xl border border-slate-200 bg-white p-8 shadow-sm">
			<h2 class="text-center text-xl font-bold text-slate-900">What field do you want to study?</h2>
			<input
				id="field-input"
				type="text"
				placeholder="e.g. Computer Science"
				class="mt-6 w-full rounded-md border border-slate-200 bg-white px-4 py-2.5 text-sm"
			/>
			<button id="field-continue" class="mt-6 w-full rounded-md bg-indigo-700 px-6 py-2.5 font-semibold text-white hover:bg-indigo-800">
				See Results
			</button>
		</section>

		<!-- Step: Results -->
		<section id="step-results" class="step hidden mt-8 rounded-2xl border border-slate-200 bg-white p-8 text-center shadow-sm">
			<h2 class="text-xl font-bold text-slate-900">We're building this next</h2>
			<p class="mt-4 leading-relaxed text-slate-600">
				Based on what you told us, here's a summary of your answers. Matching universities and
				programs to this is coming soon.
			</p>
			<div id="results-summary" class="mt-6 space-y-1 rounded-lg border border-indigo-100 bg-indigo-50 p-4 text-left text-sm text-slate-600"></div>
			<button id="restart-btn-2" class="mt-6 rounded-md bg-indigo-700 px-6 py-2.5 font-semibold text-white hover:bg-indigo-800">
				Start Over
			</button>
		</section>
	</div>
</Layout>

<script>
	const answers = { degree: "", education: "", ielts: "", german: "", field: "" };

	const steps = ["degree", "education", "language", "field"];
	function showStep(id: string) {
		document.querySelectorAll(".step").forEach((el) => el.classList.add("hidden"));
		document.getElementById(`step-${id}`)?.classList.remove("hidden");
		document.querySelectorAll(".progress-dot").forEach((dot) => {
			const dotStep = dot.getAttribute("data-step");
			const idx = steps.indexOf(dotStep || "");
			const currentIdx = steps.indexOf(id);
			dot.classList.toggle("bg-indigo-600", idx <= currentIdx && idx !== -1);
			dot.classList.toggle("bg-indigo-100", !(idx <= currentIdx) || idx === -1);
		});
	}

	// Step 1: degree choice
	document.querySelectorAll(".degree-btn").forEach((btn) => {
		btn.addEventListener("click", () => {
			answers.degree = btn.getAttribute("data-degree") || "";
			const question = document.getElementById("education-question");
			if (question) {
				if (answers.degree === "bachelors") {
					question.textContent = "Do you have 13 years of education in total?";
				} else {
					question.textContent = "Do you have 16 years of education in total?";
				}
			}
			showStep("education");
		});
	});

	// Step 2: education check
	document.querySelectorAll(".edu-btn").forEach((btn) => {
		btn.addEventListener("click", () => {
			answers.education = btn.getAttribute("data-answer") || "";
			if (answers.education === "no") {
				document.querySelectorAll(".step").forEach((el) => el.classList.add("hidden"));
				document.getElementById("step-not-eligible")?.classList.remove("hidden");
			} else {
				showStep("language");
			}
		});
	});

	// Step 3: language
	document.getElementById("language-continue")?.addEventListener("click", () => {
		const ielts = document.getElementById("ielts-select") as HTMLSelectElement;
		const german = document.getElementById("german-select") as HTMLSelectElement;
		answers.ielts = ielts.value;
		answers.german = german.value;
		showStep("field");
	});

	// Step 4: field of study
	document.getElementById("field-continue")?.addEventListener("click", () => {
		const field = document.getElementById("field-input") as HTMLInputElement;
		answers.field = field.value || "Not specified";

		const summary = document.getElementById("results-summary");
		if (summary) {
			summary.innerHTML = `
				<p><strong>Degree:</strong> ${answers.degree === "bachelors" ? "Bachelor's" : "Master's"}</p>
				<p><strong>English (IELTS):</strong> ${answers.ielts || "Not specified"}</p>
				<p><strong>German level:</strong> ${answers.german || "Not specified"}</p>
				<p><strong>Field of study:</strong> ${answers.field}</p>
			`;
		}

		document.querySelectorAll(".step").forEach((el) => el.classList.add("hidden"));
		document.getElementById("step-results")?.classList.remove("hidden");
	});

	// Restart
	function restart() {
		answers.degree = ""; answers.education = ""; answers.ielts = ""; answers.german = ""; answers.field = "";
		showStep("degree");
	}
	document.getElementById("restart-btn")?.addEventListener("click", restart);
	document.getElementById("restart-btn-2")?.addEventListener("click", restart);
</script>