---
import '../styles/global.css';
const base = import.meta.env.BASE_URL;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Find Your Path | PGNX</title>
	</head>
	<body class="min-h-screen bg-gradient-to-b from-white via-green-50 to-white text-gray-900 relative">

		<div
			class="pointer-events-none fixed inset-0 -z-10"
			style="background-image: radial-gradient(circle, #16653480 1px, transparent 1px); background-size: 24px 24px;"
		></div>

		<div class="pointer-events-none fixed left-1/2 top-40 -z-10 h-[500px] w-[500px] -translate-x-1/2 rounded-full bg-green-300 opacity-20 blur-3xl"></div>

		<!-- Top bar -->
		<header class="relative w-full py-6 px-6 flex items-center justify-end">
			<div class="absolute left-0 top-1/2 h-1 w-full -translate-y-1/2 bg-green-800"></div>
			<a href={base} class="relative z-10 flex flex-col items-center gap-1 bg-white rounded-full p-1">
				<img src={`${base}logo.jpg`} alt="PGNX logo" class="h-20 w-20 rounded-full object-cover border border-green-100" />
			</a>
		</header>

		<!-- Side menu toggle tab -->
		<button
			id="menu-toggle"
			class="fixed left-0 top-28 z-40 flex flex-col items-center gap-2 rounded-r-xl bg-green-800 text-white px-2 py-5 [writing-mode:vertical-rl]"
		>
			<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="[writing-mode:horizontal-tb] rotate-90">
				<path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
				<path d="M9 22V12h6v10"/>
			</svg>
			HOME
		</button>

		<!-- Slide-out side menu -->
		<nav
			id="side-menu"
			class="fixed left-0 top-0 h-full w-64 -translate-x-full bg-green-900 text-white p-6 transition-transform duration-300 z-50"
		>
			<button id="menu-close" class="mb-6 text-sm text-green-200">&#10005; Close</button>
			<ul class="space-y-4 font-medium">
				<li><a href={base} class="hover:text-green-300">Home</a></li>
				<li><a href={`${base}admission`} class="hover:text-green-300">Admission</a></li>
				<li><a href={`${base}visa`} class="hover:text-green-300">Visa</a></li>
				<li><a href={`${base}resources`} class="hover:text-green-300">Resources</a></li>
				<li><a href={`${base}about`} class="hover:text-green-300">About Us</a></li>
				<li><a href={`${base}contact`} class="hover:text-green-300">Contact</a></li>
			</ul>
		</nav>

		<!-- Main content -->
		<main class="px-6 py-12 max-w-2xl mx-auto">
			<a href={base} class="text-sm text-green-700 hover:text-green-900">&larr; Back to Home</a>

			<h1 class="mt-4 text-4xl font-extrabold text-green-800 text-center">Find Your Path</h1>
			<p class="mt-2 text-gray-600 text-center">Answer a few questions and we'll help point you in the right direction.</p>

			<!-- Progress -->
			<div class="mt-8 flex items-center justify-center gap-2">
				<span class="progress-dot h-2 w-8 rounded-full bg-green-800" data-step="degree"></span>
				<span class="progress-dot h-2 w-8 rounded-full bg-green-200" data-step="education"></span>
				<span class="progress-dot h-2 w-8 rounded-full bg-green-200" data-step="language"></span>
				<span class="progress-dot h-2 w-8 rounded-full bg-green-200" data-step="field"></span>
			</div>

			<!-- Step: Degree -->
			<section id="step-degree" class="step mt-8 rounded-2xl bg-white/60 backdrop-blur-sm border border-green-100 shadow-sm p-8">
				<h2 class="text-xl font-bold text-green-800 text-center">Are you applying for a Bachelor's or Master's?</h2>
				<div class="mt-6 grid gap-4 sm:grid-cols-2">
					<button class="degree-btn rounded-xl border border-green-100 bg-white p-6 text-center font-semibold text-green-800 hover:border-green-400" data-degree="bachelors">
						Bachelor's
					</button>
					<button class="degree-btn rounded-xl border border-green-100 bg-white p-6 text-center font-semibold text-green-800 hover:border-green-400" data-degree="masters">
						Master's
					</button>
				</div>
			</section>

			<!-- Step: Education check -->
			<section id="step-education" class="step hidden mt-8 rounded-2xl bg-white/60 backdrop-blur-sm border border-green-100 shadow-sm p-8">
				<h2 id="education-question" class="text-xl font-bold text-green-800 text-center"></h2>
				<div class="mt-6 grid gap-4 sm:grid-cols-2">
					<button class="edu-btn rounded-xl border border-green-100 bg-white p-6 text-center font-semibold text-green-800 hover:border-green-400" data-answer="yes">
						Yes
					</button>
					<button class="edu-btn rounded-xl border border-green-100 bg-white p-6 text-center font-semibold text-green-800 hover:border-green-400" data-answer="no">
						No
					</button>
				</div>
			</section>

			<!-- Step: Not eligible -->
			<section id="step-not-eligible" class="step hidden mt-8 rounded-2xl bg-white/60 backdrop-blur-sm border border-green-100 shadow-sm p-8 text-center">
				<h2 class="text-xl font-bold text-green-800">Not quite there yet</h2>
				<p class="mt-4 text-gray-700 leading-relaxed">
					Based on your answer, you don't currently meet the education requirement for this degree
					level. Check our <a href={`${base}admission`} class="text-green-700 underline">Admission page</a>{" "} 
					for ways to close that gap.
				</p>
				<button id="restart-btn" class="mt-6 rounded-md bg-green-800 text-white font-semibold px-6 py-2.5 hover:bg-green-900">
					Start Over
				</button>
			</section>

			<!-- Step: Language -->
			<section id="step-language" class="step hidden mt-8 rounded-2xl bg-white/60 backdrop-blur-sm border border-green-100 shadow-sm p-8">
				<h2 class="text-xl font-bold text-green-800 text-center">Your language levels</h2>
				<div class="mt-6 space-y-5">
					<div>
						<label class="block text-sm font-semibold text-gray-700">English (IELTS band)</label>
						<select id="ielts-select" class="mt-1.5 w-full rounded-md border border-green-100 bg-white px-4 py-2.5 text-sm">
							<option value="">Select your band</option>
							<option>0</option><option>1</option><option>2</option><option>3</option>
							<option>3.5</option><option>4</option><option>4.5</option><option>5</option>
							<option>5.5</option><option>6</option><option>6.5</option><option>7</option>
							<option>7.5</option><option>8</option><option>8.5</option><option>9</option>
						</select>
					</div>
					<div>
						<label class="block text-sm font-semibold text-gray-700">German level</label>
						<select id="german-select" class="mt-1.5 w-full rounded-md border border-green-100 bg-white px-4 py-2.5 text-sm">
							<option value="">Select your level</option>
							<option>A1</option><option>A2</option><option>B1</option>
							<option>B2</option><option>C1</option><option>C2</option>
							<option value="none">None yet</option>
						</select>
					</div>
				</div>
				<button id="language-continue" class="mt-6 w-full rounded-md bg-green-800 text-white font-semibold px-6 py-2.5 hover:bg-green-900">
					Continue
				</button>
			</section>

			<!-- Step: Field of study -->
			<section id="step-field" class="step hidden mt-8 rounded-2xl bg-white/60 backdrop-blur-sm border border-green-100 shadow-sm p-8">
				<h2 class="text-xl font-bold text-green-800 text-center">What field do you want to study?</h2>
				<input
					id="field-input"
					type="text"
					placeholder="e.g. Computer Science"
					class="mt-6 w-full rounded-md border border-green-100 bg-white px-4 py-2.5 text-sm"
				/>
				<button id="field-continue" class="mt-6 w-full rounded-md bg-green-800 text-white font-semibold px-6 py-2.5 hover:bg-green-900">
					See Results
				</button>
			</section>

			<!-- Step: Results -->
			<section id="step-results" class="step hidden mt-8 rounded-2xl bg-white/60 backdrop-blur-sm border border-green-100 shadow-sm p-8 text-center">
				<h2 class="text-xl font-bold text-green-800">We're building this next</h2>
				<p class="mt-4 text-gray-700 leading-relaxed">
					Based on what you told us, here's a summary of your answers. Matching universities and
					programs to this is coming soon.
				</p>
				<div id="results-summary" class="mt-6 text-left text-sm text-gray-700 space-y-1 bg-green-50 rounded-lg p-4 border border-green-100"></div>
				<button id="restart-btn-2" class="mt-6 rounded-md bg-green-800 text-white font-semibold px-6 py-2.5 hover:bg-green-900">
					Start Over
				</button>
			</section>

		</main>

		<!-- Footer -->
		<footer class="mt-12 border-t border-green-100 py-6 px-6 flex flex-col sm:flex-row items-center justify-between gap-3 text-sm text-gray-500 max-w-2xl mx-auto">
			<p>&copy; 2025 PGNX &mdash; Pakistan Germany Nexus. All rights reserved.</p>
			<div class="flex gap-4">
				<a href="#" aria-label="Facebook" class="hover:text-green-700">FB</a>
				<a href="#" aria-label="Instagram" class="hover:text-green-700">IG</a>
				<a href="#" aria-label="WhatsApp" class="hover:text-green-700">WA</a>
			</div>
		</footer>

		<script>
			const toggle = document.getElementById("menu-toggle");
			const menu = document.getElementById("side-menu");
			const close = document.getElementById("menu-close");
			toggle?.addEventListener("click", () => menu?.classList.remove("-translate-x-full"));
			close?.addEventListener("click", () => menu?.classList.add("-translate-x-full"));

			const answers = { degree: "", education: "", ielts: "", german: "", field: "" };

			const steps = ["degree", "education", "language", "field"];
			function showStep(id) {
				document.querySelectorAll(".step").forEach((el) => el.classList.add("hidden"));
				document.getElementById(`step-${id}`)?.classList.remove("hidden");
				document.querySelectorAll(".progress-dot").forEach((dot) => {
					const dotStep = dot.getAttribute("data-step");
					const idx = steps.indexOf(dotStep);
					const currentIdx = steps.indexOf(id);
					dot.classList.toggle("bg-green-800", idx <= currentIdx && idx !== -1);
					dot.classList.toggle("bg-green-200", !(idx <= currentIdx) || idx === -1);
				});
			}

			// Step 1: degree choice
			document.querySelectorAll(".degree-btn").forEach((btn) => {
				btn.addEventListener("click", () => {
					answers.degree = btn.getAttribute("data-degree");
					const question = document.getElementById("education-question");
					if (answers.degree === "bachelors") {
						question.textContent = "Do you have 13 years of education in total?";
					} else {
						question.textContent = "Do you have 16 years of education in total?";
					}
					showStep("education");
				});
			});

			// Step 2: education check
			document.querySelectorAll(".edu-btn").forEach((btn) => {
				btn.addEventListener("click", () => {
					answers.education = btn.getAttribute("data-answer");
					if (answers.education === "no") {
						document.querySelectorAll(".step").forEach((el) => el.classList.add("hidden"));
						document.getElementById("step-not-eligible")?.classList.remove("hidden");
					} else {
						showStep("language");
					}
				});
			});

			// Step 3: language
			document.getElementById("language-continue")?.addEventListener("click", () => {
				const ielts = document.getElementById("ielts-select");
				const german = document.getElementById("german-select");
				answers.ielts = ielts.value;
				answers.german = german.value;
				showStep("field");
			});

			// Step 4: field of study
			document.getElementById("field-continue")?.addEventListener("click", () => {
				const field = document.getElementById("field-input");
				answers.field = field.value || "Not specified";

				const summary = document.getElementById("results-summary");
				summary.innerHTML = `
					<p><strong>Degree:</strong> ${answers.degree === "bachelors" ? "Bachelor's" : "Master's"}</p>
					<p><strong>English (IELTS):</strong> ${answers.ielts || "Not specified"}</p>
					<p><strong>German level:</strong> ${answers.german || "Not specified"}</p>
					<p><strong>Field of study:</strong> ${answers.field}</p>
				`;

				document.querySelectorAll(".step").forEach((el) => el.classList.add("hidden"));
				document.getElementById("step-results")?.classList.remove("hidden");
			});

			// Restart
			function restart() {
				answers.degree = ""; answers.education = ""; answers.ielts = ""; answers.german = ""; answers.field = "";
				showStep("degree");
			}
			document.getElementById("restart-btn")?.addEventListener("click", restart);
			document.getElementById("restart-btn-2")?.addEventListener("click", restart);
		</script>
	</body>
</html>