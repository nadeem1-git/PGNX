---
import Layout from '../../layouts/Layout.astro';
const base = import.meta.env.BASE_URL;
---

<Layout title="Universities">
	<div class="overflow-hidden rounded-2xl bg-slate-900 text-white shadow-xl">
		<div class="flex items-center justify-between px-8 pt-8">
			<div>
				<p class="text-sm text-indigo-300">Universities <span class="mx-1">&rsaquo;</span> To overview</p>
				<h1 class="mt-1 text-2xl font-bold">Study program</h1>
			</div>
		</div>

		<ul class="mt-6 border-t border-white/10">
			<li class="border-b border-white/10">
				<a
					href={`${base}universities/bachelors`}
					class="menu-row group flex items-center justify-between px-8 py-5 text-lg text-slate-200 transition-colors hover:bg-white/5 hover:text-white"
				>
					<span class="menu-label">Bachelor's degree programs</span>
					<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-indigo-300 transition-transform group-hover:translate-x-1">
						<path d="M9 6l6 6-6 6"/>
					</svg>
				</a>
			</li>
			<li class="border-b border-white/10">
				<a
					href={`${base}universities/masters`}
					class="menu-row group flex items-center justify-between px-8 py-5 text-lg text-slate-200 transition-colors hover:bg-white/5 hover:text-white"
				>
					<span class="menu-label">Master's degree programs</span>
					<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-indigo-300 transition-transform group-hover:translate-x-1">
						<path d="M9 6l6 6-6 6"/>
					</svg>
				</a>
			</li>
		</ul>

		<p class="px-8 py-5 text-sm text-slate-400">
			724 Master's programs across 17 fields &middot; Bachelor's programs coming soon
		</p>
	</div>

	<style>
		.menu-label {
			position: relative;
		}
		.menu-row:hover .menu-label::after {
			content: "";
			position: absolute;
			left: 0;
			right: 0;
			bottom: -4px;
			height: 1px;
			background: currentColor;
		}
	</style>
</Layout>