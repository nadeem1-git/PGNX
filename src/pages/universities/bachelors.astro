---
import Layout from '../../layouts/Layout.astro';
const base = import.meta.env.BASE_URL;
---

<Layout title="Bachelor's Programs">
	<div class="mx-auto max-w-2xl py-12 text-center">
		<a href={`${base}universities`} class="mb-8 block text-left text-sm text-indigo-600 hover:text-indigo-700">&larr; Bachelor's / Master's</a>

		<h1 class="text-3xl font-extrabold text-slate-900">Bachelor's Programs</h1>
		<p class="mt-4 text-slate-600">
			This section is coming soon. In the meantime, check out our <a href={`${base}universities/masters`} class="font-medium text-indigo-600 underline">Master's Programs</a> listing.
		</p>
	</div>
</Layout>