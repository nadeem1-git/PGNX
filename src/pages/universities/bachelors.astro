---
import '../../styles/global.css';
const base = import.meta.env.BASE_URL;

// You already have a separate "Bachelor Programs" page with the Bachelor's
// dataset. Point this at its real route (e.g. `${base}bachelor-programs`).
// Once you confirm the route, you can either:
//   a) keep this as a short redirect page (simplest), or
//   b) delete this file and change the "Bachelor's Programs" link on
//      universities/index.astro to go straight to that page.
const bachelorPageHref = `${base}bachelor-programs`;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Bachelor's Programs | PGNX</title>
		<meta http-equiv="refresh" content={`0; url=${bachelorPageHref}`} />
	</head>
	<body class="min-h-screen bg-gradient-to-b from-white via-green-50 to-white text-gray-900 flex items-center justify-center">
		<main class="px-6 py-12 max-w-md mx-auto text-center">
			<h1 class="text-2xl font-bold text-green-800">Bachelor's Programs</h1>
			<p class="mt-3 text-gray-600">
				Redirecting you to the Bachelor's programs page…
			</p>
			<a href={bachelorPageHref} class="mt-4 inline-block text-green-700 underline">
				Click here if you're not redirected
			</a>
		</main>
	</body>
</html>
