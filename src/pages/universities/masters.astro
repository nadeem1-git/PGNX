---
import '../../styles/global.css';
import ProgramCard from '../../components/ProgramCard.astro';
import programsData from '../../data/masterPrograms.json';

const base = import.meta.env.BASE_URL;

type Program = {
  id: string;
  degree: string;
  category: string;
  university: string;
  course: string;
  ownership: 'Public' | 'Private';
  link: string | null;
  requirements: string;
};

const programs = (programsData as Program[]).slice().sort((a, b) => a.course.localeCompare(b.course));

const categoryCounts = new Map<string, number>();
for (const p of programs) {
  categoryCounts.set(p.category, (categoryCounts.get(p.category) ?? 0) + 1);
}
const categories = [...categoryCounts.entries()].sort((a, b) => a[0].localeCompare(b[0]));
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Master's Programs | PGNX</title>
	</head>
	<body class="min-h-screen bg-gradient-to-b from-white via-green-50 to-white text-gray-900 relative">

		<div
			class="pointer-events-none fixed inset-0 -z-10"
			style="background-image: radial-gradient(circle, #16653480 1px, transparent 1px); background-size: 24px 24px;"
		></div>

		<!-- Top bar -->
		<header class="relative w-full py-6 px-6 flex items-center justify-end">
			<div class="absolute left-0 top-1/2 h-1 w-full -translate-y-1/2 bg-green-800"></div>
			<a href={base} class="relative z-10 flex flex-col items-center gap-1 bg-white rounded-full p-1">
				<img src={`${base}logo.jpg`} alt="PGNX logo" class="h-20 w-20 rounded-full object-cover border border-green-100" />
			</a>
		</header>

		<button
			id="menu-toggle"
			class="fixed left-0 top-28 z-40 flex flex-col items-center gap-2 rounded-r-xl bg-green-800 text-white px-2 py-5 [writing-mode:vertical-rl]"
		>
			<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="[writing-mode:horizontal-tb] rotate-90">
				<path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
				<path d="M9 22V12h6v10"/>
			</svg>
			HOME
		</button>

		<nav
			id="side-menu"
			class="fixed left-0 top-0 h-full w-64 -translate-x-full bg-green-900 text-white p-6 transition-transform duration-300 z-50"
		>
			<button id="menu-close" class="mb-6 text-sm text-green-200">&#10005; Close</button>
			<ul class="space-y-4 font-medium">
				<li><a href={base} class="hover:text-green-300">Home</a></li>
				<li><a href={`${base}admission`} class="hover:text-green-300">Admission</a></li>
				<li><a href={`${base}visa`} class="hover:text-green-300">Visa</a></li>
				<li><a href={`${base}resources`} class="hover:text-green-300">Resources</a></li>
				<li><a href={`${base}about`} class="hover:text-green-300">About Us</a></li>
				<li><a href={`${base}contact`} class="hover:text-green-300">Contact</a></li>
			</ul>
		</nav>

		<main class="px-6 py-12 max-w-6xl mx-auto">
			<a href={`${base}universities`} class="text-sm text-green-700 hover:text-green-900">&larr; Bachelor's / Master's</a>

			<h1 class="mt-4 text-4xl font-extrabold text-green-800">Master's Programs</h1>
			<p class="mt-2 text-gray-600 max-w-2xl">
				Search or filter {programs.length} programs across {categories.length} fields, then open the program page directly.
			</p>

			<!-- Toolbar -->
			<div class="mt-8 flex flex-col sm:flex-row gap-3">
				<input
					id="search-input"
					type="text"
					placeholder="Search by course or university…"
					class="flex-1 rounded-full border border-green-200 bg-white shadow-sm px-6 py-3.5 text-base focus:outline-none focus:ring-2 focus:ring-green-400"
				/>
				<select
					id="sort-select"
					class="rounded-full border border-green-200 bg-white shadow-sm px-5 py-3.5 text-sm font-medium text-green-800 focus:outline-none focus:ring-2 focus:ring-green-400"
				>
					<option value="course-asc">Course: A &rarr; Z</option>
					<option value="course-desc">Course: Z &rarr; A</option>
					<option value="university-asc">University: A &rarr; Z</option>
					<option value="field-asc">Field: A &rarr; Z</option>
				</select>
			</div>

			<!-- Ownership filter -->
			<div class="mt-3 flex flex-wrap items-center gap-2">
				<span class="text-xs font-semibold uppercase tracking-wide text-gray-500 mr-1">Ownership:</span>
				<button data-owner="all" class="owner-btn text-sm font-medium px-4 py-1.5 rounded-full border border-green-700 bg-green-800 text-white">All</button>
				<button data-owner="Public" class="owner-btn text-sm font-medium px-4 py-1.5 rounded-full border border-green-200 bg-white text-green-800 hover:border-green-400">Public</button>
				<button data-owner="Private" class="owner-btn text-sm font-medium px-4 py-1.5 rounded-full border border-green-200 bg-white text-green-800 hover:border-green-400">Private</button>
			</div>

			<!-- Narrow results by field -->
			<div class="mt-3 rounded-xl border border-green-100 bg-white/70 backdrop-blur-sm shadow-sm">
				<button
					id="narrow-toggle"
					class="w-full flex items-center justify-between px-5 py-3 text-sm font-semibold text-green-800"
				>
					<span>Narrow results by field (A&ndash;Z)</span>
					<span id="narrow-icon" class="text-xl leading-none text-green-700">+</span>
				</button>
				<div id="narrow-panel" class="hidden px-5 pb-4 flex flex-wrap gap-2">
					<button data-cat="all" class="pill-btn text-sm font-medium px-4 py-1.5 rounded-full border border-green-700 bg-green-800 text-white">
						All ({programs.length})
					</button>
					{categories.map(([cat, count]) => (
						<button data-cat={cat} class="pill-btn text-sm font-medium px-4 py-1.5 rounded-full border border-green-200 bg-white text-green-800 hover:border-green-400">
							{cat} ({count})
						</button>
					))}
				</div>
			</div>

			<div class="mt-6 flex items-center justify-between">
				<p id="results-count" class="font-bold text-lg text-green-900"></p>
				<button id="reset-btn" class="text-sm font-medium px-4 py-2 border border-green-300 rounded-full text-green-700 hover:bg-green-50">
					Reset filters
				</button>
			</div>

			<div class="mt-4 rounded-lg bg-amber-50 border border-amber-200 p-4 text-sm text-amber-900 max-w-2xl">
				<strong>Please note:</strong> this is a reference list, not a live feed — deadlines, fees, ownership, and
				links change over time. Always confirm current details on each university's official website before applying.
			</div>

			<!-- Results grid -->
			<div id="program-grid" class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
				{programs.map((p) => (
					<ProgramCard
						course={p.course}
						university={p.university}
						ownership={p.ownership}
						requirements={p.requirements}
						link={p.link}
						category={p.category}
					/>
				))}
			</div>

			<p id="no-results" class="hidden mt-10 text-center text-gray-500">No programs match your search.</p>
		</main>

		<footer class="mt-12 border-t border-green-100 py-6 px-6 flex flex-col sm:flex-row items-center justify-between gap-3 text-sm text-gray-500 max-w-6xl mx-auto">
			<p>&copy; 2025 PGNX &mdash; Pakistan Germany Nexus. All rights reserved.</p>
			<div class="flex gap-4">
				<a href="#" aria-label="Facebook" class="hover:text-green-700">FB</a>
				<a href="#" aria-label="Instagram" class="hover:text-green-700">IG</a>
				<a href="#" aria-label="WhatsApp" class="hover:text-green-700">WA</a>
			</div>
		</footer>

		<script>
			const toggle = document.getElementById("menu-toggle");
			const menu = document.getElementById("side-menu");
			const close = document.getElementById("menu-close");
			toggle?.addEventListener("click", () => menu?.classList.remove("-translate-x-full"));
			close?.addEventListener("click", () => menu?.classList.add("-translate-x-full"));

			const searchInput = document.getElementById("search-input") as HTMLInputElement;
			const sortSelect = document.getElementById("sort-select") as HTMLSelectElement;
			const pillButtons = Array.from(document.querySelectorAll<HTMLButtonElement>(".pill-btn"));
			const ownerButtons = Array.from(document.querySelectorAll<HTMLButtonElement>(".owner-btn"));
			const grid = document.getElementById("program-grid") as HTMLElement;
			const cards = Array.from(document.querySelectorAll<HTMLElement>(".program-card"));
			const resultsCount = document.getElementById("results-count");
			const noResults = document.getElementById("no-results");
			const narrowToggle = document.getElementById("narrow-toggle");
			const narrowPanel = document.getElementById("narrow-panel");
			const narrowIcon = document.getElementById("narrow-icon");
			const resetBtn = document.getElementById("reset-btn");

			let activeCategory = "all";
			let activeOwnership = "all";
			const collator = new Intl.Collator();

			function setActive(buttons: HTMLButtonElement[], matchAttr: string, activeValue: string) {
				buttons.forEach((b) => {
					const isActive = b.dataset[matchAttr] === activeValue;
					b.classList.toggle("bg-green-800", isActive);
					b.classList.toggle("text-white", isActive);
					b.classList.toggle("border-green-700", isActive);
					b.classList.toggle("bg-white", !isActive);
					b.classList.toggle("text-green-800", !isActive);
					b.classList.toggle("border-green-200", !isActive);
				});
			}

			function applyFilters() {
				const query = searchInput.value.trim().toLowerCase();
				let visible = 0;

				for (const card of cards) {
					const matchesCategory = activeCategory === "all" || card.dataset.category === activeCategory;
					const matchesOwnership = activeOwnership === "all" || card.dataset.ownership === activeOwnership;
					const matchesQuery =
						!query ||
						card.dataset.course?.includes(query) ||
						card.dataset.university?.includes(query);

					const show = matchesCategory && matchesOwnership && matchesQuery;
					card.classList.toggle("hidden", !show);
					if (show) visible++;
				}

				if (resultsCount) resultsCount.textContent = `${visible} result${visible === 1 ? "" : "s"} found`;
				noResults?.classList.toggle("hidden", visible !== 0);
			}

			function applySort() {
				const sortBy = sortSelect.value;
				const sorted = [...cards].sort((a, b) => {
					if (sortBy === "course-desc") return collator.compare(b.dataset.course || "", a.dataset.course || "");
					if (sortBy === "university-asc") return collator.compare(a.dataset.university || "", b.dataset.university || "");
					if (sortBy === "field-asc") {
						return (
							collator.compare(a.dataset.category || "", b.dataset.category || "") ||
							collator.compare(a.dataset.course || "", b.dataset.course || "")
						);
					}
					return collator.compare(a.dataset.course || "", b.dataset.course || "");
				});
				sorted.forEach((card) => grid.appendChild(card));
			}

			narrowToggle?.addEventListener("click", () => {
				const isHidden = narrowPanel?.classList.toggle("hidden");
				if (narrowIcon) narrowIcon.textContent = isHidden ? "+" : "\u2212";
			});

			pillButtons.forEach((btn) => {
				btn.addEventListener("click", () => {
					activeCategory = btn.dataset.cat || "all";
					setActive(pillButtons, "cat", activeCategory);
					applyFilters();
				});
			});

			ownerButtons.forEach((btn) => {
				btn.addEventListener("click", () => {
					activeOwnership = btn.dataset.owner || "all";
					setActive(ownerButtons, "owner", activeOwnership);
					applyFilters();
				});
			});

			resetBtn?.addEventListener("click", () => {
				searchInput.value = "";
				sortSelect.value = "course-asc";
				activeCategory = "all";
				activeOwnership = "all";
				setActive(pillButtons, "cat", "all");
				setActive(ownerButtons, "owner", "all");
				applySort();
				applyFilters();
			});

			searchInput?.addEventListener("input", applyFilters);
			sortSelect?.addEventListener("change", applySort);
			setActive(pillButtons, "cat", "all");
			setActive(ownerButtons, "owner", "all");
			applyFilters();
		</script>
	</body>
</html>