---
import Layout from '../../layouts/Layout.astro';
import ProgramCard from '../../components/ProgramCard.astro';
import programsData from '../../data/masterPrograms.json';

const base = import.meta.env.BASE_URL;

type Program = {
  id: string;
  degree: string;
  category: string;
  university: string;
  course: string;
  ownership: 'Public' | 'Private';
  link: string | null;
  requirements: string;
};

const programs = (programsData as Program[]).slice().sort((a, b) => a.course.localeCompare(b.course));

const categoryCounts = new Map<string, number>();
for (const p of programs) {
  categoryCounts.set(p.category, (categoryCounts.get(p.category) ?? 0) + 1);
}
const categories = [...categoryCounts.entries()].sort((a, b) => a[0].localeCompare(b[0]));
---

<Layout title="Master's Programs">
	<a href={`${base}universities`} class="text-sm text-indigo-600 hover:text-indigo-700">&larr; Bachelor's / Master's</a>

	<h1 class="mt-4 text-4xl font-extrabold text-slate-900">Master's Programs</h1>
	<p class="mt-2 max-w-2xl text-slate-600">
		Search or filter {programs.length} programs across {categories.length} fields, then open the program page directly.
	</p>

	<!-- Toolbar -->
	<div class="mt-8 flex flex-col gap-3 sm:flex-row">
		<input
			id="search-input"
			type="text"
			placeholder="Search by course or university…"
			class="flex-1 rounded-full border border-slate-200 bg-white px-6 py-3.5 text-base shadow-sm focus:outline-none focus:ring-2 focus:ring-indigo-400"
		/>
		<select
			id="sort-select"
			class="rounded-full border border-slate-200 bg-white px-5 py-3.5 text-sm font-medium text-indigo-700 shadow-sm focus:outline-none focus:ring-2 focus:ring-indigo-400"
		>
			<option value="course-asc">Course: A &rarr; Z</option>
			<option value="course-desc">Course: Z &rarr; A</option>
			<option value="university-asc">University: A &rarr; Z</option>
			<option value="field-asc">Field: A &rarr; Z</option>
		</select>
	</div>

	<!-- Ownership filter -->
	<div class="mt-3 flex flex-wrap items-center gap-2">
		<span class="mr-1 text-xs font-semibold uppercase tracking-wide text-slate-500">Ownership:</span>
		<button data-owner="all" class="owner-btn rounded-full border border-indigo-600 bg-indigo-600 px-4 py-1.5 text-sm font-medium text-white">All</button>
		<button data-owner="Public" class="owner-btn rounded-full border border-slate-200 bg-white px-4 py-1.5 text-sm font-medium text-indigo-700 hover:border-indigo-400">Public</button>
		<button data-owner="Private" class="owner-btn rounded-full border border-slate-200 bg-white px-4 py-1.5 text-sm font-medium text-indigo-700 hover:border-indigo-400">Private</button>
	</div>

	<!-- Narrow results by field -->
	<div class="mt-3 rounded-xl border border-slate-200 bg-white shadow-sm">
		<button
			id="narrow-toggle"
			class="flex w-full items-center justify-between px-5 py-3 text-sm font-semibold text-slate-900"
		>
			<span>Narrow results by field (A&ndash;Z)</span>
			<span id="narrow-icon" class="text-xl leading-none text-indigo-600">+</span>
		</button>
		<div id="narrow-panel" class="hidden flex-wrap gap-2 px-5 pb-4">
			<button data-cat="all" class="pill-btn rounded-full border border-indigo-600 bg-indigo-600 px-4 py-1.5 text-sm font-medium text-white">
				All ({programs.length})
			</button>
			{categories.map(([cat, count]) => (
				<button data-cat={cat} class="pill-btn rounded-full border border-slate-200 bg-white px-4 py-1.5 text-sm font-medium text-indigo-700 hover:border-indigo-400">
					{cat} ({count})
				</button>
			))}
		</div>
	</div>

	<div class="mt-6 flex items-center justify-between">
		<p id="results-count" class="text-lg font-bold text-slate-900"></p>
		<button id="reset-btn" class="rounded-full border border-slate-300 px-4 py-2 text-sm font-medium text-indigo-600 hover:bg-indigo-50">
			Reset filters
		</button>
	</div>

	<div class="mt-4 max-w-2xl rounded-lg border border-amber-200 bg-amber-50 p-4 text-sm text-amber-900">
		<strong>Please note:</strong> this is a reference list, not a live feed — deadlines, fees, ownership, and
		links change over time. Always confirm current details on each university's official website before applying.
	</div>

	<!-- Results grid -->
	<div id="program-grid" class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
		{programs.map((p) => (
			<ProgramCard
				course={p.course}
				university={p.university}
				ownership={p.ownership}
				requirements={p.requirements}
				link={p.link}
				category={p.category}
			/>
		))}
	</div>

	<p id="no-results" class="mt-10 hidden text-center text-slate-500">No programs match your search.</p>
</Layout>

<script>
	const searchInput = document.getElementById("search-input") as HTMLInputElement;
	const sortSelect = document.getElementById("sort-select") as HTMLSelectElement;
	const pillButtons = Array.from(document.querySelectorAll<HTMLButtonElement>(".pill-btn"));
	const ownerButtons = Array.from(document.querySelectorAll<HTMLButtonElement>(".owner-btn"));
	const grid = document.getElementById("program-grid") as HTMLElement;
	const cards = Array.from(document.querySelectorAll<HTMLElement>(".program-card"));
	const resultsCount = document.getElementById("results-count");
	const noResults = document.getElementById("no-results");
	const narrowToggle = document.getElementById("narrow-toggle");
	const narrowPanel = document.getElementById("narrow-panel");
	const narrowIcon = document.getElementById("narrow-icon");
	const resetBtn = document.getElementById("reset-btn");

	let activeCategory = "all";
	let activeOwnership = "all";
	const collator = new Intl.Collator();

	function setActive(buttons: HTMLButtonElement[], matchAttr: string, activeValue: string) {
		buttons.forEach((b) => {
			const isActive = b.dataset[matchAttr] === activeValue;
			b.classList.toggle("bg-indigo-600", isActive);
			b.classList.toggle("text-white", isActive);
			b.classList.toggle("border-indigo-600", isActive);
			b.classList.toggle("bg-white", !isActive);
			b.classList.toggle("text-indigo-700", !isActive);
			b.classList.toggle("border-slate-200", !isActive);
		});
	}

	function applyFilters() {
		const query = searchInput.value.trim().toLowerCase();
		let visible = 0;

		for (const card of cards) {
			const matchesCategory = activeCategory === "all" || card.dataset.category === activeCategory;
			const matchesOwnership = activeOwnership === "all" || card.dataset.ownership === activeOwnership;
			const matchesQuery =
				!query ||
				card.dataset.course?.includes(query) ||
				card.dataset.university?.includes(query);

			const show = matchesCategory && matchesOwnership && matchesQuery;
			card.classList.toggle("hidden", !show);
			if (show) visible++;
		}

		if (resultsCount) resultsCount.textContent = `${visible} result${visible === 1 ? "" : "s"} found`;
		noResults?.classList.toggle("hidden", visible !== 0);
	}

	function applySort() {
		const sortBy = sortSelect.value;
		const sorted = [...cards].sort((a, b) => {
			if (sortBy === "course-desc") return collator.compare(b.dataset.course || "", a.dataset.course || "");
			if (sortBy === "university-asc") return collator.compare(a.dataset.university || "", b.dataset.university || "");
			if (sortBy === "field-asc") {
				return (
					collator.compare(a.dataset.category || "", b.dataset.category || "") ||
					collator.compare(a.dataset.course || "", b.dataset.course || "")
				);
			}
			return collator.compare(a.dataset.course || "", b.dataset.course || "");
		});
		sorted.forEach((card) => grid.appendChild(card));
	}

	narrowToggle?.addEventListener("click", () => {
		const isHidden = narrowPanel?.classList.toggle("hidden");
		narrowPanel?.classList.toggle("flex", !isHidden);
		if (narrowIcon) narrowIcon.textContent = isHidden ? "+" : "\u2212";
	});

	pillButtons.forEach((btn) => {
		btn.addEventListener("click", () => {
			activeCategory = btn.dataset.cat || "all";
			setActive(pillButtons, "cat", activeCategory);
			applyFilters();
		});
	});

	ownerButtons.forEach((btn) => {
		btn.addEventListener("click", () => {
			activeOwnership = btn.dataset.owner || "all";
			setActive(ownerButtons, "owner", activeOwnership);
			applyFilters();
		});
	});

	resetBtn?.addEventListener("click", () => {
		searchInput.value = "";
		sortSelect.value = "course-asc";
		activeCategory = "all";
		activeOwnership = "all";
		setActive(pillButtons, "cat", "all");
		setActive(ownerButtons, "owner", "all");
		applySort();
		applyFilters();
	});

	searchInput?.addEventListener("input", applyFilters);
	sortSelect?.addEventListener("change", applySort);
	setActive(pillButtons, "cat", "all");
	setActive(ownerButtons, "owner", "all");
	applyFilters();
</script>