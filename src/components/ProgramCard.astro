---
// Reusable card used for every program on the Universities pages.
// Keeping this as one component is what makes the design "constant" —
// every program (any category) renders through this exact same markup.
export interface Props {
  course: string;
  university: string;
  ownership: "Public" | "Private";
  requirements: string;
  link?: string | null;
  category?: string;
}

const { course, university, ownership, requirements, link, category } = Astro.props;
---

<article
  class="program-card rounded-xl bg-white/70 backdrop-blur-sm border border-green-100 shadow-sm p-5 flex flex-col gap-3 hover:shadow-md hover:border-green-200 transition-shadow"
  data-university={university.toLowerCase()}
  data-course={course.toLowerCase()}
  data-category={category}
  data-ownership={ownership}
>
  <div>
    <h3 class="text-base font-bold text-green-900 leading-snug">{course}</h3>
    <p class="mt-1 text-sm text-gray-700">{university}</p>
  </div>

  <div class="flex flex-wrap gap-2 mt-auto">
    <span
      class={`text-xs font-medium px-2.5 py-1 rounded-full ${
        ownership === "Public"
          ? "bg-green-50 text-green-800 border border-green-200"
          : "bg-amber-50 text-amber-800 border border-amber-200"
      }`}
    >
      {ownership}
    </span>
    <span class="text-xs font-medium px-2.5 py-1 rounded-full bg-gray-50 text-gray-700 border border-gray-200">
      {requirements}
    </span>
  </div>

  {
    link ? (
      <a
        href={link}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-1 inline-flex items-center gap-1 text-sm font-semibold text-green-700 hover:text-green-900"
      >
        Visit program page
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M7 17L17 7" />
          <path d="M7 7h10v10" />
        </svg>
      </a>
    ) : (
      <span class="mt-1 text-sm text-gray-400 italic">No direct link on file — search the university's site</span>
    )
  }
</article>
